<?xml version="1.0" encoding="UTF-8"?>
<!--
  tests/xml-schemas/all.xsd (#188) — ONE SCHEMA THAT IMPORTS EVERY PUBLISHED
  ONE, and declares nothing of its own.

  xmllint validates a document against one schema, and a document this
  service emits spans several namespaces: a SOAP envelope around a WS-Trust
  response around a SAML assertion around an XML Signature. Every one of
  those containers holds its content through a wildcard with
  processContents="lax" — which validates an element STRICTLY when a
  declaration for it is loaded, and skips it silently when none is. So the
  schema a document is checked against has to have loaded EVERY namespace
  it could contain, or the part of the document inside the first wildcard
  is not checked at all. This file is that set; the job adds the other half
  of the guarantee by refusing a document that uses a namespace no import
  below covers (tests/vendored/sts_xml_schema_validation.js, `covered()`).

  Each import names the local file tests/tools/fetch-xml-schemas.sh put
  beside this one; the imports INSIDE the published files are resolved by
  catalog.xml.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:iya-sts:tests:xml-schema-validation"
           elementFormDefault="qualified">

  <xs:import namespace="http://www.w3.org/XML/1998/namespace"
             schemaLocation="xml.xsd"/>
  <xs:import namespace="http://www.w3.org/2000/09/xmldsig#"
             schemaLocation="xmldsig-core-schema.xsd"/>
  <xs:import namespace="http://www.w3.org/2009/xmldsig11#"
             schemaLocation="xmldsig11-schema.xsd"/>
  <xs:import namespace="http://www.w3.org/2001/04/xmlenc#"
             schemaLocation="xenc-schema.xsd"/>
  <xs:import namespace="http://www.w3.org/2009/xmlenc11#"
             schemaLocation="xenc-schema-11.xsd"/>

  <xs:import namespace="urn:oasis:names:tc:SAML:2.0:assertion"
             schemaLocation="saml-schema-assertion-2.0.xsd"/>
  <xs:import namespace="urn:oasis:names:tc:SAML:2.0:protocol"
             schemaLocation="saml-schema-protocol-2.0.xsd"/>
  <xs:import namespace="urn:oasis:names:tc:SAML:2.0:metadata"
             schemaLocation="saml-schema-metadata-2.0.xsd"/>
  <xs:import namespace="urn:oasis:names:tc:SAML:1.0:assertion"
             schemaLocation="oasis-sstc-saml-schema-assertion-1.1.xsd"/>
  <xs:import namespace="urn:oasis:names:tc:SAML:1.0:protocol"
             schemaLocation="oasis-sstc-saml-schema-protocol-1.1.xsd"/>

  <xs:import namespace="http://schemas.xmlsoap.org/soap/envelope/"
             schemaLocation="soap-envelope-1.1.xsd"/>
  <xs:import namespace="http://www.w3.org/2003/05/soap-envelope"
             schemaLocation="soap-envelope-1.2.xsd"/>
  <xs:import namespace="http://www.w3.org/2005/08/addressing"
             schemaLocation="ws-addr.xsd"/>
  <xs:import namespace="http://schemas.xmlsoap.org/ws/2004/08/addressing"
             schemaLocation="addressing-2004-08.xsd"/>
  <xs:import namespace="http://schemas.xmlsoap.org/ws/2004/03/addressing"
             schemaLocation="addressing-2004-03.xsd"/>
  <xs:import namespace="http://schemas.xmlsoap.org/ws/2004/09/policy"
             schemaLocation="ws-policy-2004-09.xsd"/>
  <xs:import namespace="http://schemas.xmlsoap.org/ws/2002/12/policy"
             schemaLocation="ws-policy-2002-12.xsd"/>
  <xs:import namespace="http://schemas.xmlsoap.org/ws/2004/09/mex"
             schemaLocation="MetadataExchange.xsd"/>

  <xs:import namespace="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
             schemaLocation="oasis-200401-wss-wssecurity-secext-1.0.xsd"/>
  <xs:import namespace="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"
             schemaLocation="oasis-200401-wss-wssecurity-utility-1.0.xsd"/>
  <xs:import namespace="http://docs.oasis-open.org/wss/oasis-wss-wssecurity-secext-1.1.xsd"
             schemaLocation="oasis-wss-wssecurity-secext-1.1.xsd"/>

  <xs:import namespace="http://schemas.xmlsoap.org/ws/2004/04/trust"
             schemaLocation="ws-trust-2004-04.xsd"/>
  <xs:import namespace="http://schemas.xmlsoap.org/ws/2005/02/trust"
             schemaLocation="ws-trust-2005-02.xsd"/>
  <!-- THE DERIVED COPY, not ws-trust-1.3.xsd: the published file's
       targetNamespace carries a trailing slash the specification's namespace
       does not (tests/tools/fetch-xml-schemas.sh's header; #188). -->
  <xs:import namespace="http://docs.oasis-open.org/ws-sx/ws-trust/200512"
             schemaLocation="ws-trust-1.3-ns.xsd"/>
  <xs:import namespace="http://docs.oasis-open.org/ws-sx/ws-trust/200802"
             schemaLocation="ws-trust-1.4.xsd"/>
  <xs:import namespace="http://docs.oasis-open.org/ws-sx/ws-securitypolicy/200702"
             schemaLocation="ws-securitypolicy-1.2.xsd"/>

  <xs:import namespace="http://docs.oasis-open.org/wsfed/federation/200706"
             schemaLocation="ws-federation.xsd"/>
  <xs:import namespace="http://docs.oasis-open.org/wsfed/authorization/200706"
             schemaLocation="ws-authorization.xsd"/>
</xs:schema>
