    },
    `parameters`:#[
      #{
        `name`:"idpInitiatedPage",
        `in`:"query",
        `required`:false,
        `schema`:null,
        `description`:"Which page of `idpInitiated` to return, answered by `idpInitiatedPaging`. The applications, by identifier."
      },
      #{
        `name`:"per",
        `in`:"query",
        `required`:false,
        `schema`:null,
        `description`:"Rows per page. Defaults to 50 and is capped at 300. On a drill-down it is SHARED by every list in the reply, which each carry a page number of their own."
      }
    ],
