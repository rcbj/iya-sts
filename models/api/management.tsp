@endpoint("/admin-api/users/begin-passkey-enrolment",
  "post",
  #{
    `operationId`:"beginUserPasskeyEnrolment",
    `summary`:"Begin enrolling a passkey for somebody, in your own browser",
    `description`:"Mints a WebAuthn registration challenge bound to YOU (the access token's subject, which must be a person), the person and the lane, held for five minutes at most and usable once, and answers the ceremony your browser runs (`ceremony`): the challenge, the realm's RP ID, the PERSON's user handle (`user.id`, per lane, #643) with their name and display name (the passkey policy's userDisplayName), the credentials to exclude (the person's keys in that lane) and `options` — the algorithms offered in order and the realm's attestation, user verification, resident key, hints and timeout. Every byte string is base64url.\n\nRefused unless the person's passkey policy's `adminEnrolment` is `on` (STS-AUTHN-0440, off by default), the person is in this realm's directory (STS-AUTHN-0441), the caller is a person (STS-AUTHN-0445), the realm accepts a passkey at all (STS-AUTHN-0531), and the lane and `webauthn.maxKeysPerPerson` allow it. No role is asked: a passkey has none since #1135, and the realm decides at each sign-in how it is used. There is no import of a registration made elsewhere.\n\n**Mirrors** `POST /admin/users, POST /admin/users/new, POST /admin/users/edit and POST /admin/users/service-account` on the admin console.",
    `tags`:#["Users"],
    `responses`:#{
      `200`:#{
        `description`:"`enrolmentId`, `expiresAt`, `lane`, `kind` and `ceremony`, or why it was not begun.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `beginUserPasskeyEnrolment`(@js(#{`examples`:#[#{`user`:"alice",`kind`:"security-key"}]}) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"The person, as /admin-api/users names them."}) `user`: string;
    @js(#{`description`:"Accepted for `user`."}) `username`?: string;
