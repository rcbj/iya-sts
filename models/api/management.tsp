@endpoint("/admin-api/claims",
  "get",
  #{
    `operationId`:"getClaims",
    `summary`:"The custom claims every new token and assertion will carry",
    `description`:"The four sets — OAuth 2.0 access token, OIDC ID Token, SAML 2.0 Attribute, SAML 1.1 Attribute — with the rules that govern them: the claim names this service sets itself and will not let you override, and the placeholders a value may use.\n\nEach set has TWO HALVES and they are configured by different operations. `claims` are TYPED: a name and a value somebody wrote, the same for everybody except where a \${placeholder} carries the sign-in. `attributes` are LDAP ATTRIBUTE TYPES chosen from `attributeCatalogue`, whose value is read off that person's entry under ou=users — so an `ldapmodify` changes the next token, and an LDAP client and an OIDC client pointed at this service are shown the same person.\n\n`attributeClaims` is what the current selection would actually put in each set for the previewed person, built by the same function the issuance path calls. A caller with no browser has no other way to ask \"what would this issue\".\n\n**Mirrors** `GET /admin/claims` on the admin console.",
    `tags`:#["Custom claims"],
    `responses`:#{
      `200`:#{
        `description`:"The four sets, the attribute catalogue and the preview.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `parameters`:#[
      #{
        `name`:"user",
        `in`:"query",
        `required`:false,
        `schema`:null,
        `description`:"Whose attribute values to preview. Defaults to a person the directory holds from startup, so the preview shows real values on a fresh process. Somebody with no entry gets generated values — the same invented person every time, seeded from the name — and `preview.entryFound` says which of the two happened."
      }
    ],
    `security`:#[#{`oauth2`:#["admin:read"]},#{`bearerAuth`:#[]}]
  })
op `getClaims`(@js(#{`default`:"alice"}) `parameters/0/schema`: string,
  `responses/200/content/application~1json/schema`: `ClaimSets`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/claims/add",
  "post",
  #{
    `operationId`:"addClaim",
    `summary`:"Add one claim to one set",
    `description`:"Every token of that kind issued from now on carries it; nothing already issued changes.\n\nADDITIVE ONLY. What the protocol puts in is never displaced — an ID Token's `sub`, a SAML 2.0 assertion's `name`, a WS-Federation assertion's whole identity claim list. A name this service sets itself is REFUSED rather than allowed to win, because every one of those is load-bearing — a settable `exp` would produce tokens that fail to verify with nothing pointing back at the call that caused it. `GET /admin-api/claims` lists the refused names.\n\n**Mirrors** `POST /admin/claims` on the admin console.",
    `tags`:#["Custom claims"],
    `responses`:#{
      `200`:#{
        `description`:"The set as it now stands, in `claims`.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `addClaim`(@js(#{`examples`:#[#{`set`:"id_token",`name`:"dept",`value`:"engineering"}]}) `requestBody/content/application~1json/schema`: {
    `set`: "access_token" | "id_token";
    `name`: string;
    @js(#{`description`:"May carry a \${...} placeholder."}) `value`?: string;
    @js(#{
      `description`:"The Kerberos PAC set only (#493): the PAC claim type. Defaults to string; ignored by the other sets."
