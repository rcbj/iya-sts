      `200`:#{
        `description`:"The operation was applied.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `editXacmlMatch`(@js(#{
    `examples`:#[
      #{
        `policy`:"my-policy",
        `path`:"target.anyOf.0.allOf.0.matches.0",
        `matchId`:"urn:oasis:names:tc:xacml:1.0:function:string-equal",
        `value`:"staff",
        `attributeId`:"employeeType"
      }
    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{
      `description`:"The directory entry name of the policy to edit — the `cn` under ou=policies, not the PolicyId inside the document."
    }) `policy`: string;
    @js(#{
      `description`:"The node's address, from GET /admin-api/xacml/editor. ONLY VALID AGAINST THE DOCUMENT IT WAS READ FROM: remove rule 0 and every path naming rule 1 now means rule 0."
    }) `path`: string;
    @js(#{
      `description`:"The match function. Defaults to string-equal. THE DATATYPE FOLLOWS IT on both sides, so choosing the function settles the literal's type and the designator's together."
    }) `matchId`?: string;
    @js(#{`description`:"The literal to test against."}) `value`?: string;
    @js(#{`description`:"The attribute category. Defaults to access-subject."}) `category`?: string;
    @js(#{
      `description`:"The attribute to read. A bare name or the `urn:sts:xacml:attribute:` prefix reaches the directory through the PIP; anything else must be in the request."
    }) `attributeId`?: string;
