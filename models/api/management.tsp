    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{
      `pattern`:"^[a-z0-9][a-z0-9-]{0,62}$",
      `description`:"The policy's name."
    }) `name`: string;
    @js(#{`maxLength`:1024,`description`:"What the policy is for."}) `description`?: string;
    `precedence`?: post_admin_api_policies_save_named_authn_policy_b_application_json_precedence_h3005;
    @js(#{
      `description`:"The first-factor mechanisms allowed: password, password-mfa, webauthn, spnego, wallet, federation."
