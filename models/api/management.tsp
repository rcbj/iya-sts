    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `setGroupMail`(@js(#{`examples`:#[#{`group`:"developers",`mail`:"developers@example.com"}]}) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"The group's `cn` or its whole DN."}) `group`: string;
