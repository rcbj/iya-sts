@endpoint("/admin-api/xacml/add-rule-obligation",
  "post",
  #{
    `operationId`:"addXacmlRuleObligation",
    `summary`:"Add an obligation to a rule",
    `description`:"Fires when this RULE's Effect is the decision. An obligation is the half of a decision that says \"yes, AND you must also do this\", and section 7.2 makes it binding: a PEP that cannot discharge one MUST NOT grant the access. The remote PEP container implements that, and /admin/xacml/decide shows it — and it is the part implementations skip.\n\n**Mirrors** `POST /admin/xacml#xacml-tab-policies, POST /admin/xacml#xacml-tab-editor, POST /admin/xacml#xacml-tab-peps, POST /admin/xacml/policies, POST /admin/xacml/editor and POST /admin/xacml/peps` on the admin console.",
    `tags`:#["XACML"],
    `responses`:#{
      `200`:#{
        `description`:"The operation was applied.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `addXacmlRuleObligation`(@js(#{`examples`:#[#{`policy`:"my-policy",`path`:"rules.0",`on`:"Permit"}]}) `requestBody/content/application~1json/schema`: {
    @js(#{
      `description`:"The directory entry name of the policy to edit — the `cn` under ou=policies, not the PolicyId inside the document."
    }) `policy`: string;
    @js(#{
      `description`:"The node's address, from GET /admin-api/xacml/editor. ONLY VALID AGAINST THE DOCUMENT IT WAS READ FROM: remove rule 0 and every path naming rule 1 now means rule 0."
    }) `path`: string;
    @js(#{
      `description`:"Permit or Deny — the effect this fires on. Defaults to Permit. An obligation attached to the wrong effect is silently never discharged."
    }) `on`?: "Permit" | "Deny"
  },
  `responses/200/content/application~1json/schema`: `SharedModel308`,
