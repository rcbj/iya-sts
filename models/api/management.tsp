@endpoint("/admin-api/xacml/edit-match",
  "post",
  #{
    `operationId`:"editXacmlMatch",
    `summary`:"Change a Match's function, value or attribute",
    `description`:"THE DATATYPE FOLLOWS THE FUNCTION. A Match whose literal is a string and whose designator is an integer does not type-check, so choosing the function sets both sides rather than letting them be picked independently and refused later.\n\n**Mirrors** `POST /admin/xacml#xacml-tab-policies, POST /admin/xacml#xacml-tab-editor, POST /admin/xacml#xacml-tab-peps, POST /admin/xacml/policies, POST /admin/xacml/editor and POST /admin/xacml/peps` on the admin console.",
    `tags`:#["XACML"],
