        `in`:"query",
        `required`:false,
        `schema`:null,
        `description`:"Whose credential to preview. Defaults to a person the directory holds from startup, so the preview shows real values on a fresh process."
      }
    ],
    `security`:#[#{`oauth2`:#["admin:read"]},#{`bearerAuth`:#[]}]
  })
