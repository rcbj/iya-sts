@endpoint("/admin-api/kerberos/claims/add",
  "post",
  #{
    `operationId`:"addKerberosPacClaim",
    `summary`:"Add one claim to one set",
    `description`:"Every ticket of that kind issued from now on carries it; nothing already issued changes.\n\nADDITIVE ONLY. What the protocol puts in is never displaced — an ID Token's `sub`, a SAML 2.0 assertion's `name`, a WS-Federation assertion's whole identity claim list. There is NO reserved list here: those names are load-bearing in a JWT, and an assertion attribute called `exp` collides with nothing. An entry with no name, and two entries of one name, are still refused.\n\n**Mirrors** `POST /admin/kerberos#kerberos-tab-claims` on the admin console.",
    `tags`:#["Kerberos"],
    `responses`:#{
      `200`:#{
        `description`:"The set as it now stands, in `claims`.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
