@endpoint("/admin-api/policies/save-named-authn-policy",
  "post",
  #{
    `operationId`:"saveNamedAuthnPolicy",
    `summary`:"Create or replace a named authentication policy in this realm",
    `description`:"Writes `cn=<name>,ou=authnPolicies` in this realm's directory: the first-factor mechanisms (`mechanisms`) and the second factors (`secondFactors`) a sign-in allows where this policy applies — each list the WHOLE list, none allowing every one (and leaving the realm's second factors as they are) — and its `precedence` (#1237). It applies where the application names it (`appAuthnPolicy`) or one of the person's groups does (`stsAuthnPolicy`) and its precedence is the lowest of those named, ties by name. **The realm's own**: not inherited from the default realm. The name is lower-case letters, digits and hyphens, not `default` (STS-AUTHN-0532); an unknown mechanism is refused (STS-AUTHN-0533), and a precedence that is not a whole number from 1 to 1000 (STS-AUTHN-0541).\n\n**Mirrors** `POST /admin/policies` on the admin console.",
    `tags`:#["Policies"],
    `responses`:#{
      `200`:#{
        `description`:"What was done, and the sentence saying so.",
        `content`:#{`application/json`:#{`schema`:null}}
