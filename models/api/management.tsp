    }) `trustDomain`: string;
    @js(#{
      `description`:"The bundle, as a JWK Set with `spiffe_sequence` and `spiffe_refresh_hint`. A JSON string is accepted too, which is what the console's textarea sends.",
      `$noProps`:true,
