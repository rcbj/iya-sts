    `examples`:#[#{`rp`:"urn:example:app",`shire`:"https://app.example.com/saml/acs"}]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"The relying party's identifier."}) `rp`: string;
    @js(#{
      `format`:"uri",
      `description`:"The assertion consumer service URL registered on the relying party."
