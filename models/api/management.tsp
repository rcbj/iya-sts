  `parameters/1/schema`: string,
  `parameters/2/schema`: (string)[],
  @js(#{`minimum`:1}) `parameters/3/schema`: integer,
  @js(#{`minimum`:1,`maximum`:300}) `parameters/4/schema`: integer,
