    }) `field`: "spiffeId" | "parentId" | "selectors" | "dnsNames" | "federatesWith" | "x509SvidTtl" | "jwtSvidTtl" | "hint" | "expiresAt" | "admin" | "downstream" | "storeSvid";
    @js(#{
