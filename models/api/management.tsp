        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `addUserInfoAttributeClaim`(@js(#{
    `examples`:#[#{`set`:"userinfo",`name`:"cost_center",`attribute`:"costCenter"}]
  }) `requestBody/content/application~1json/schema`: {
    `set`: "userinfo";
    `name`: string;
    @js(#{`description`:"The directory attribute."}) `attribute`: string;
    @js(#{`description`:"Every value rather than the first."}) `multi`?: boolean;
    @js(#{
      `description`:"The JSON type of each value, in a JWT or UserInfo set. Ignored by the SAML sets."
    }) `type`?: "string" | "number" | "boolean" | "json";
    @js(#{`description`:"The SAML 2.0 set only."}) `nameFormat`?: string;
    @js(#{`description`:"The SAML 1.1 set only."}) `namespace`?: string
