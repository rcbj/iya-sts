@js(#{`minimum`:0,`maximum`:24}) @hoisted scalar post_admin_api_policies_save_password_policy_b_application_json_history_v0_h2958 extends integer;
  

@js(#{
    `description`:"How many of a person's PREVIOUS passwords are remembered and refused. The current password is always refused as well while this is above 0, so 5 means a new password may be none of the last six. 0 turns the rule off. The draft's attribute, with the draft's meaning. Each remembered password is kept as the hash it was already stored as (argon2id or scrypt), in pwdHistory on the person's own entry, and checking a new password costs one hash comparison per one remembered. Between 0 and 24. Default 5.",
    `$comb`:"oneOf"
  }) @hoisted union post_admin_api_policies_save_password_policy_b_application_json_history_h2959 {
    post_admin_api_policies_save_password_policy_b_application_json_history_v0_h2958,
    string
  }

@js(#{`minimum`:0,`maximum`:16}) @hoisted scalar post_admin_api_policies_save_password_policy_b_application_json_minSymbols_v0_h2960 extends integer;
  

@js(#{
    `description`:"Always 0. A policy that asks for symbols is refused: ASVS 5.0.0 6.2.5 requires that a password of any composition be accepted, so length is what this policy asks for. Between 0 and 16. Default 0.",
    `$comb`:"oneOf"
  }) @hoisted union post_admin_api_policies_save_password_policy_b_application_json_minSymbols_h2961 {
    post_admin_api_policies_save_password_policy_b_application_json_minSymbols_v0_h2960,
    string
  }

@js(#{
    `description`:"Always off. A policy that requires an uppercase letter is refused: ASVS 5.0.0 6.2.5 requires that a password of any composition be accepted. (`true`/`false`, or `TRUE`/`FALSE` from a form.) Default false.",
    `$comb`:"oneOf"
  }) @hoisted union post_admin_api_policies_save_password_policy_b_application_json_requireUppercase_h2962 {boolean, string}

@js(#{
    `description`:"Always off. A policy that requires a number is refused: ASVS 5.0.0 6.2.5 requires that a password of any composition be accepted. (`true`/`false`, or `TRUE`/`FALSE` from a form.) Default false.",
    `$comb`:"oneOf"
  }) @hoisted union post_admin_api_policies_save_password_policy_b_application_json_requireDigit_h2963 {boolean, string}

@js(#{`minimum`:12,`maximum`:128}) @hoisted scalar post_admin_api_policies_save_password_policy_b_application_json_generatedLength_v0_h2964 extends integer;
  

@js(#{
    `description`:"How long a password this service MAKES UP is — for a new user created from the console or /admin-api, an operator's Generate, and the product-mode bootstrap account. It must be at least the minimum length and at least twice the symbol count plus two. Twenty characters from a 90-character alphabet is about 130 bits. Between 12 and 128. Default 20.",
    `$comb`:"oneOf"
  }) @hoisted union post_admin_api_policies_save_password_policy_b_application_json_generatedLength_h2965 {
