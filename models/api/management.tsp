@endpoint("/admin-api/applications/regenerate-secret",
  "post",
  #{
    `operationId`:"regenerateApplicationClientSecret",
    `summary`:"Mint a new client secret for an application, replacing every one it holds",
    `description`:"Mints `oauth2.registeredSecretBytes` random bytes, base64url — the way `POST /oauth2/register` mints one — as the application's ONLY secret, a record on `oauthClientSecret` expiring after `oauth2.clientSecretLifetimeDays` days (never at 0), and into the stored RFC 7591 registration document where there is one.\n\n**EVERY SECRET IT HELD STOPS AUTHENTICATING AT ONCE**, wherever the token endpoint checks a secret (RFC 9700 mode, product mode). **THIS REPLY IS THE ONE PLACE THE NEW VALUE IS HANDED OUT BY THIS ACT** — the audit row names the attribute and never the value — though `GET /admin-api/applications?application=` reads the entry back for an `admin:read` token, as it always has.\n\n`sts-api-client` is REFUSED while `adminApi.clientSecret` pins its secret: every token for this API is minted with that setting, and seeding never writes over an existing entry.\n\n**Mirrors** `POST /admin/applications, POST /admin/applications/new, POST /admin/applications/edit and POST /admin/applications/owners` on the admin console.",
    `tags`:#["Applications"],
    `responses`:#{
      `200`:#{
        `description`:"The new secret in `clientSecret`, its `secretId` and `expiresAt`, whether one was replaced, and the application as it now stands.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
