@endpoint("/admin-api/verifications/start",
  "post",
  #{
    `operationId`:"startVerification",
    `summary`:"Start an OpenID4VP verification: build a request for a wallet",
    `description`:"Builds a presentation request — the one door a verification starts at since #594 — and answers how a wallet is handed it: `walletUrl` (what a same-device start redirects to: the web wallet `wallet` named or `oid4vp.walletUrl` configures, with the request on its query, or — with neither, the default — the same as `requestUri`), `requestUri` (the request under the scheme a wallet app registers for: `openid4vp://`, HAIP's `haip-vp://` where `oid4vp.walletInvocation` says so, or SIOPv2's `siopv2://` for an ID Token alone; what a cross-device QR code carries), `wallet` (the address or scheme before the query), `query` itself, and — by reference — the `request_uri` the wallet fetches the signed Request Object from. `state` names it; `GET /verifications?state=` reads its outcome.\n\nThe body names what the page's query names, every member optional: `format` (a format id, `GET /verifier-request` lists them; the configured default when absent), `by` (`value` or `reference`), `client_id_prefix` (a signed request's Client Identifier Prefix — naming one asks for a request by reference), `response_type`, `response_mode`, `mode` (`same-device` or `cross-device`, which only says which of the two addresses a caller means to use) and `wallet` (held to `oid4vp.walletUrl` and `oid4vp.allowedWalletUrls` wherever only registered addresses are accepted).\n\n`redirect_uri` (#594) is the caller's own page the Response Endpoint sends the wallet to once it has answered (OpenID4VP 1.0 section 8.2). Wherever only registered addresses are accepted it must be one of the CALLING CLIENT's registered redirect URIs, matched whole (400, STS-VC-0123); left off, the Response Endpoint answers no `redirect_uri` — what a wallet on another device wants.\n\nWhat the request ASKS FOR is the Verifier request's configuration (`/verifier-request`), frozen onto the transaction now. Refused as the page refuses: 400 for what the request names wrongly (STS-VC-0032) and for a wallet this realm will not send a request to (STS-VC-0033), and 500 with the builder's own code where no request can be built — a Verifier Attestation this realm cannot use (STS-VC-0092), an x509 Client Identifier with nothing to certify (STS-VC-0110 to STS-VC-0113). Answered in every mode: this is an administrator asking.\n\n**Mirrors** `POST /admin/vc#vc-tab-verifier-request` on the admin console.",
    `tags`:#["Verifier request"],
    `responses`:#{
      `200`:#{
        `description`:"`state`, `walletUrl`, `requestUri`, `query`, the `request_uri` by reference, and what was asked: `ok`, `message`, `state`, `nonce`, `mode`, `format`, `responseType`, `responseMode`, `byReference`, `clientId`, `requested`, `dcql_query`, `expiresAt`, `wallet`, `walletUrl`, `requestUri`, `query`, `redirectUri` ('' for none) and, by reference, `request_uri`.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:false,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `startVerification`(@js(#{
    `examples`:#[
      #{`format`:"dc+sd-jwt",`by`:"reference"},
      #{`mode`:"same-device",`redirect_uri`:"https://rp.example/verified"}
    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{
      `description`:"A format id: dc+sd-jwt, jwt_vc_json, ldp_vc, mso_mdoc. Not a closed set here, as on `/verifier-request/format`: a form-encoded `+` arrives as a space and is put back, and the Verifier refuses anything else by name."
    }) `format`?: string;
    `by`?: "value" | "reference";
    `client_id_prefix`?: "pre-registered" | "decentralized_identifier" | "verifier_attestation" | "openid_federation" | "x509_san_dns" | "x509_hash";
    `response_type`?: "vp_token" | "id_token" | "vp_token id_token";
    `response_mode`?: "direct_post" | "direct_post.jwt" | "form_post";
    `mode`?: "same-device" | "cross-device";
    @js(#{
      `description`:"A web wallet to send the holder to, if not `oid4vp.walletUrl` or a wallet app (the default)."
    }) `wallet`?: string;
    @js(#{
      `maxLength`:2048,
      `description`:"The caller's page the wallet is sent to once the Verifier has answered (#594); a registered redirect URI of the calling client wherever only registered addresses are accepted."
    }) `redirect_uri`?: string
  },
  `responses/200/content/application~1json/schema`: `SharedModel225`,
  `responses/400/content/application~1json/schema`: `SharedModel225`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@js(#{
    `additionalProperties`:false,
