@endpoint("/admin-api/xacml/add-target-anyof",
  "post",
  #{
    `operationId`:"addXacmlTargetClause",
    `summary`:"Add a Target clause to a policy, a rule or a Target",
    `description`:"A `<Target>` is a list of clauses and **every one of them must match** — they are ANDed. Inside a clause the alternatives are ORed and inside an alternative the Matches are ANDed again, so the quantifier flips at each of the three levels.\n\nThat is why the element names read backwards from what they do: `AnyOf` holds `AllOf` holds `Match`, and the `AnyOf`s themselves are ANDed. Getting it wrong produces a policy that applies to more or less than was meant and never an error.\n\n**Mirrors** `POST /admin/xacml#xacml-tab-policies, POST /admin/xacml#xacml-tab-editor, POST /admin/xacml#xacml-tab-peps, POST /admin/xacml/policies, POST /admin/xacml/editor and POST /admin/xacml/peps` on the admin console.",
    `tags`:#["XACML"],
    `responses`:#{
      `200`:#{
        `description`:"The operation was applied.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `addXacmlTargetClause`(@js(#{
    `examples`:#[
      #{
        `policy`:"my-policy",
        `path`:"",
        `matchId`:"urn:oasis:names:tc:xacml:1.0:function:string-equal",
        `value`:"staff",
        `category`:"urn:oasis:names:tc:xacml:1.0:subject-category:access-subject",
        `attributeId`:"employeeType"
      }
    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{
      `description`:"The directory entry name of the policy to edit — the `cn` under ou=policies, not the PolicyId inside the document."
    }) `policy`: string;
    @js(#{
      `description`:"The node's address, from GET /admin-api/xacml/editor. ONLY VALID AGAINST THE DOCUMENT IT WAS READ FROM: remove rule 0 and every path naming rule 1 now means rule 0."
    }) `path`?: string;
    @js(#{
      `description`:"The match function. Defaults to string-equal. THE DATATYPE FOLLOWS IT on both sides, so choosing the function settles the literal's type and the designator's together."
    }) `matchId`?: string;
    @js(#{`description`:"The literal to test against."}) `value`?: string;
