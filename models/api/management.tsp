@endpoint("/admin-api/users/reset-password",
  "post",
  #{
    `operationId`:"resetUserPassword",
    `summary`:"Reset somebody's password to a generated one, returned once",
    `description`:"Generates a password under this realm's password policy, sets it, and **returns it ONCE** in `password` — the entry holds a scrypt hash and nothing can show it again. Then three things the ordinary `set-password` does not do: `pwdReset` is set, so the person must choose their own password at the sign-in screen before anything is signed in; any password reset link outstanding is spent; and they are **signed out of everything** through the same function `POST /admin-api/logout/global` calls.\n\n**Shared Signals**: a CAEP `credential-change` (`password`, `update`) and a RISC `account-credential-change-required`, plus a CAEP `session-revoked` for each session the sign-out ends. They are sent after the reply, and `caep.autoEmitTypes` and `risc.autoEmitTypes` decide whether they go at all.\n\n**Mirrors** `POST /admin/users, POST /admin/users/new, POST /admin/users/edit and POST /admin/users/service-account` on the admin console.",
    `tags`:#["Users"],
    `responses`:#{
      `200`:#{
        `description`:"The generated password, ONCE, whether the forced change was recorded (`forcedChange`) and what the sign-out ended (`signedOut`).",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `resetUserPassword`(@js(#{`examples`:#[#{`user`:"alice"},#{`user`:"alice",`compromised`:true}]}) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"The person, as /admin-api/users names them."}) `user`: string;
    @js(#{`description`:"Accepted for `user`."}) `username`?: string;
    @js(#{
      `description`:"The reset is BECAUSE a credential was compromised: RISC `credential-compromise` (`password`) is sent as well (#146)."
    }) `compromised`?: boolean
  },
  `responses/200/content/application~1json/schema`: `SharedModel104`,
  `responses/400/content/application~1json/schema`: `SharedModel104`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/users/issue-password-reset",
  "post",
  #{
    `operationId`:"issuePasswordResetLink",
    `summary`:"Revoke somebody's password and issue a one-time reset link",
    `description`:"Mints a single-use link to `/portal/reset-password`, **returned ONCE** in `resetUrl` (absolute, on the address this request arrived at, realm prefix included), valid for `security.passwordResetTtlMinutes`. The token in it is stored as a hash; issuing another replaces it.\n\n**The password the person had is REMOVED** and they are **signed out of everything**, so until the link is used they cannot sign in with a password. At the link they choose a new one under the realm's password policy; the removed password is in the history, so it cannot simply be chosen again where the history is enforced.\n\n**Shared Signals**: a CAEP `credential-change` (`password`, `revoke`) where a password was removed, a RISC `account-credential-change-required` and `recovery-activated` (#146), RISC `credential-compromise` when `compromised` is true, and a CAEP `credential-change` (`password`, `create`) when the link is spent.\n\n**Mirrors** `POST /admin/users, POST /admin/users/new, POST /admin/users/edit and POST /admin/users/service-account` on the admin console.",
    `tags`:#["Users"],
    `responses`:#{
      `200`:#{
        `description`:"The reset link, ONCE, when it expires, whether a password was removed (`passwordRevoked`) and what the sign-out ended.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `issuePasswordResetLink`(@js(#{`examples`:#[#{`user`:"alice"},#{`user`:"alice",`compromised`:true}]}) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"The person, as /admin-api/users names them."}) `user`: string;
    @js(#{`description`:"Accepted for `user`."}) `username`?: string;
    @js(#{
      `description`:"The reset is BECAUSE a credential was compromised: RISC `credential-compromise` (`password`) is sent as well (#146)."
    }) `compromised`?: boolean;
    @js(#{
      `description`:"`mail` (#63) sends the link to the address on the person's entry through the realm's mail transport and does NOT return it: the answer carries `mailedTo`. If it cannot be mailed the link is returned as with `show` (the default), with `mailError` saying why."
    }) `deliver`?: "show" | "mail"
  },
  `responses/200/content/application~1json/schema`: `SharedModel105`,
  `responses/400/content/application~1json/schema`: `SharedModel105`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/users/disable-primary-keys",
  "post",
  #{
    `operationId`:"disableUserPasskeys",
    `summary`:"Remove every passkey somebody holds",
    `description`:"Removes every passkey (WebAuthn credential) the person holds. Until #1135 it removed only the keys enrolled in the `primary` role; a passkey has no role since, so it takes all of them, and they sign in with their password afterwards.\n\n**Refused where it would leave no way in** (STS-AUTHN-0161): a person with no password, in a realm where a passkey may be a first factor, whose passkeys are their way in. Reset their password or issue a reset link first. Refused too for somebody holding no passkey (STS-AUTHN-0160).\n\n**Shared Signals**: a CAEP `credential-change` (`fido2-roaming`, `delete`) per key, with its label as `friendly_name`.\n\n**Mirrors** `POST /admin/users, POST /admin/users/new, POST /admin/users/edit and POST /admin/users/service-account` on the admin console.",
    `tags`:#["Users"],
    `responses`:#{
      `200`:#{
        `description`:"The keys removed — id, label and when enrolled; never a public key, and no role since #1135. `sessionsEnded` counts the sessions those keys signed in, which were ended (#963); every other stays.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `disableUserPasskeys`(@js(#{`examples`:#[#{`user`:"alice"}]}) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"The person, as /admin-api/users names them."}) `user`: string;
    @js(#{`description`:"Accepted for `user`."}) `username`?: string
  },
  `responses/200/content/application~1json/schema`: `SharedModel106`,
  `responses/400/content/application~1json/schema`: `SharedModel106`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/users/disable-mfa",
  "post",
  #{
    `operationId`:"disableUserSecondFactors",
    `summary`:"Remove every second factor somebody holds",
    `description`:"Removes the authenticator app enrolment, every passkey and the recovery codes, in one act. Until #1135 it took only the keys enrolled in the `mfa` role; a passkey has no role since, and any of them may answer the second step, so it takes all of them. **Refused where the passkeys are their way in** (STS-AUTHN-0161): a person with no password, in a realm where a passkey may be a first factor, who holds one. Reset their password or issue a reset link first. If a second factor is still REQUIRED of the person — `require-mfa`, or the realm's authentication policy — their next sign-in asks them to enrol a new one, which is how to reset somebody's MFA.\n\nRefused for somebody who holds no second factor.\n\n**Shared Signals**: a CAEP `credential-change` (`delete`) for the authenticator app (`app`) and for each key (`fido2-roaming`), and a RISC `recovery-information-changed` where recovery codes were removed.\n\n**Mirrors** `POST /admin/users, POST /admin/users/new, POST /admin/users/edit and POST /admin/users/service-account` on the admin console.",
    `tags`:#["Users"],
    `responses`:#{
      `200`:#{
        `description`:"What was removed, and whether a second factor is still required of them (`requirement`). `sessionsEnded` counts the sessions each removed factor signed in, which were ended (#963); every other stays.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
