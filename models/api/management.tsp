        `in`:"query",
        `required`:false,
        `schema`:null,
        `description`:"With `list=model`: the AAGUID, or `unreported` for keys whose authenticator named none."
      },
      #{
        `name`:"page",
        `in`:"query",
        `required`:false,
        `schema`:null,
        `description`:"Which page of `list.rows`."
      },
      #{
        `name`:"per",
        `in`:"query",
        `required`:false,
        `schema`:null,
