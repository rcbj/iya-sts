@endpoint("/admin-api/kerberos/trusts/pair",
  "post",
  #{
    `operationId`:"pairKerberosTrust",
    `summary`:"Write the matching record on the partner trust realm",
    `description`:"For a record whose partner is another trust realm of this service (`partnerRealm`), writes that realm's record for this one in the same act — its incoming key this realm's outgoing and the other way round, the same attributes and enctypes — or, where it already holds one, makes its keys match. With `otherRealm` (a trust realm's id) instead, writes BOTH records from nothing, from one password or one generated key set. Either way it writes another realm's directory, so it is a service administrator's act.\n\n**Mirrors** `POST /admin/kerberos#kerberos-tab-trusts, POST /admin/kerberos/trusts` on the admin console.",
    `tags`:#["Kerberos"],
    `responses`:#{
      `200`:#{
        `description`:"Both records' views, whether the other was created or matched, and a generated key once in `shown`.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `pairKerberosTrust`(@js(#{
    `examples`:#[
      #{`partnerRealm`:"BETA.EXAMPLE"},
      #{`otherRealm`:"beta",`keySource`:"generate"}
    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"A record held here, to mirror."}) `partnerRealm`?: string;
    @js(#{`description`:"A trust realm's id, to pair from nothing."}) `otherRealm`?: string;
    @js(#{`description`:"With `otherRealm`: the keys, from this realm's side."}) `direction`?: "bidirectional" | "inbound" | "outbound";
    @js(#{`description`:"With `otherRealm`."}) `keySource`?: "password" | "generate";
    @js(#{`description`:"With `keySource: \"password\"`."}) `password`?: string;
    @js(#{`description`:"With `otherRealm`."}) `attributes`?: (string)[];
    `enctypes`?: post_admin_api_kerberos_trusts_pair_b_application_json_enctypes_h2897;
    `suffixes`?: post_admin_api_kerberos_trusts_pair_b_application_json_suffixes_h2898;
