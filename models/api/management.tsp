@endpoint("/admin-api/applications/update-fields",
  "post",
  #{
    `operationId`:"updateApplicationFields",
    `summary`:"Set several attributes of an application at once",
    `description`:"What the Save button of an application's field grid on the console does. Each member of `fields` names an editable attribute and gives what it should hold: a single-valued attribute is SET (an empty string or array clears it), and a multi-valued one has the values not given removed and the values not yet held added — exactly `set`, `add` and `remove`, applied per attribute, so every rule those hold still holds. An attribute whose values did not change is not written. `protocols`, when given, replaces the declared protocol families, and is written first, so a family-scoped attribute may be set in the same call that declares its family.\n\nWhat one attribute refuses does not undo another: the reply names what was saved (`changed`) and every refusal, and answers 400 when there was any.\n\n**Mirrors** `POST /admin/applications, POST /admin/applications/new, POST /admin/applications/edit and POST /admin/applications/owners` on the admin console.",
    `tags`:#["Applications"],
    `responses`:#{
      `200`:#{
        `description`:"The attributes saved (`changed`) and the application as it now stands.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `updateApplicationFields`(@js(#{
    `patternProperties`:#{
      `^field\\.`:#{
        `type`:#["string","array"],
        `items`:#{`type`:"string"},
        `description`:"The console form's boxes: `field.<attribute>.<n>` one value each, in box order, or `field.<attribute>` with a value per line. Merged over `fields`."
      }
    },
    `examples`:#[
      #{
        `application`:"my-web-app",
        `fields`:#{
          `oauthRedirectUri`:#["https://app.example.com/callback"],
          `oauthRequirePushedAuthorizationRequests`:"TRUE"
        }
      }
    ]
  }) `requestBody/content/application~1json/schema`: {
    `application`: string;
    @js(#{`$noProps`:true,`$open`:true}) `fields`?: {};
    `protocols`?: (string)[];
    `protocolsPresent`?: post_admin_api_applications_update_fields_b_application_json_protocolsPresent_h2728;
    `present`?: post_admin_api_applications_update_fields_b_application_json_present_h2729
  },
  `responses/200/content/application~1json/schema`: `SharedModel258`,
  `responses/400/content/application~1json/schema`: `SharedModel258`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/applications/confirm-address",
  "post",
  #{
    `operationId`:"confirmApplicationReturnAddress",
    `summary`:"Confirm a return address a development-mode request recorded",
    `description`:"A return address — a SAML ACS URL or `shire` on `samlAssertionConsumerService`, a WS-Federation `wreply` on `wsfedReplyUrl`, or a callback this service learnt for its own console or portal on `oauthRedirectUri` — that a request NAMED while the realm was in DEVELOPMENT mode is written onto the entry and MARKED on `appReturnAddressObserved` (`<attribute> <address>`). **PRODUCT mode refuses a marked address** exactly as it refuses one that is not on the entry, so a realm switched from development to product does not trust what development learnt.\n\nThis takes the mark OFF and keeps the address, so product believes it from the next request. An address that is not marked is REFUSED by name rather than confirmed silently — it is already registered, or it is not on the entry. `add` of the same address confirms it too, because an explicit write is a registration.\n\nGET /admin-api/applications?application=… lists the marked addresses as `returnAddressesObserved`, each with `trusted` saying whether THIS realm's mode believes it. Addresses recorded before this service marked sightings carry no mark and cannot be told apart from registered ones.\n\n**Mirrors** `POST /admin/applications, POST /admin/applications/new, POST /admin/applications/edit and POST /admin/applications/owners` on the admin console.",
    `tags`:#["Applications"],
    `responses`:#{
      `200`:#{
        `description`:"The application as it now stands, with the mark gone from `returnAddressesObserved`.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `confirmApplicationReturnAddress`(@js(#{
    `examples`:#[
      #{
        `application`:"https://sp.example.com",
        `attribute`:"samlAssertionConsumerService",
        `value`:"https://sp.example.com/acs"
      }
    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"The identifier, exactly as the registry holds it."}) `application`: string;
    @js(#{`description`:"The return-address attribute the address is on."}) `attribute`: "oauthRedirectUri" | "samlAssertionConsumerService" | "wsfedReplyUrl" | "gnapFinishUri";
    @js(#{`description`:"The address, exactly as the entry holds it."}) `value`: string
  },
  `responses/200/content/application~1json/schema`: `SharedModel254`,
  `responses/400/content/application~1json/schema`: `SharedModel254`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/applications/discard-address",
  "post",
  #{
    `operationId`:"discardApplicationReturnAddress",
    `summary`:"Discard a return address a development-mode request recorded",
    `description`:"The opposite answer to `confirm-address`: the address was recorded from a request in DEVELOPMENT mode and is NOT this application's, so the mark on `appReturnAddressObserved` AND the address itself are taken off the entry. Product mode then refuses it as an address that is not there; development records it again, marked, if a request names it again.\n\nAn address that is not marked is REFUSED rather than removed — discarding is not the door for taking a REGISTERED address off an entry, and `remove` is, which says so.\n\n**Mirrors** `POST /admin/applications, POST /admin/applications/new, POST /admin/applications/edit and POST /admin/applications/owners` on the admin console.",
    `tags`:#["Applications"],
    `responses`:#{
      `200`:#{
        `description`:"The application as it now stands, without the address or its mark.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `discardApplicationReturnAddress`(@js(#{
    `examples`:#[
      #{
        `application`:"urn:example:crm",
        `attribute`:"wsfedReplyUrl",
        `value`:"https://evil.example/wsfed"
      }
    ]
  }) `requestBody/content/application~1json/schema`: {
    `application`: string;
    `attribute`: "oauthRedirectUri" | "samlAssertionConsumerService" | "wsfedReplyUrl" | "gnapFinishUri";
    `value`: string
  },
  `responses/200/content/application~1json/schema`: `SharedModel254`,
  `responses/400/content/application~1json/schema`: `SharedModel254`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/applications/add-owner",
  "post",
  #{
    `operationId`:"addApplicationOwner",
    `summary`:"Add one owner to an application",
    `description`:"Adds a person or a group of this realm to the application's `appOwner` values and writes at once. `owner` is a username, a DN or a `urn:uuid:` subject for a person, a `cn` or DN for a group. One that names nobody is refused; at most 25. An owner already listed is `ok` with `changed: false`.\n\n**AN OWNER GRANTS NOTHING**; the user portal lists what a person owns.\n\n**Mirrors** `POST /admin/applications, POST /admin/applications/new, POST /admin/applications/edit and POST /admin/applications/owners` on the admin console.",
    `tags`:#["Applications"],
