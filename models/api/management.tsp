@js(#{
    `description`:"The shortest password this service will set, counted in characters (Unicode code points, so an emoji is one). The attribute is draft-behera-ldap-password-policy's. Twelve is the default; NIST SP 800-63B asks for at least 8, and 15 where a password is the only factor. Between 1 and 1024. Default 12.",
    `$comb`:"oneOf"
  }) @hoisted union post_admin_api_policies_save_password_policy_b_application_json_minLength_h2957 {
    post_admin_api_policies_save_password_policy_b_application_json_minLength_v0_h2956,
