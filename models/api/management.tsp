@endpoint("/admin-api/federation/create",
  "post",
  #{
    `operationId`:"createFederationRelationship",
    `summary`:"Register a federation relationship",
    `description`:"It is created **DISABLED**, whatever this request says, and nothing about it does anything until `enable` is called. That is the one place this operation overrides its input, and it is deliberate: a partner that half-exists and silently accepts assertions is the failure this whole register is arranged to prevent, so enabling is a second act that says the configuration is finished.\n\n**ONE RELATIONSHIP IS ONE DIRECTION.** A partner this service both consumes from and asserts to is two relationships with two ids, because everything that configures one differs by direction.\n\nThe reply carries `readiness.missing` — the fields this protocol and role still need — so a caller can go straight on to `set` for each of them without knowing the schema in advance.\n\n**Mirrors** `POST /admin/federation` on the admin console.",
    `tags`:#["Federation"],
    `responses`:#{
      `200`:#{
        `description`:"The relationship as created, and what it still needs before it can be enabled usefully.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `createFederationRelationship`(@js(#{
    `examples`:#[
      #{
        `id`:"partner-a",
        `role`:"service-provider",
        `protocol`:"saml2",
        `name`:"Partner A",
        `peer`:"https://idp.partner.example/saml"
      }
    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{
      `description`:"The key, the RDN and a URL segment. It has to start with a letter or a digit and hold only letters, digits, dot, dash and underscore, up to 63 characters."
    }) `id`: string;
    @js(#{
      `description`:"Which end THIS SERVICE is. `service-provider` means a foreign identity provider authenticates the person and this service consumes what it issues."
    }) `role`: "service-provider" | "identity-provider";
    @js(#{
      `description`:"The protocol the relationship runs in. `ssf` (#374) is a partner that signs nobody in and only sends Shared Signals; it takes the service-provider role."
    }) `protocol`: "saml2" | "saml11" | "wsfed" | "oidc" | "oauth2" | "ssf";
    @js(#{
      `description`:"What to call the partner on a page. The id is the name when this is omitted."
    }) `name`?: string;
    @js(#{
      `description`:"The partner's own identifier — a SAML entityID, an OpenID Connect issuer, a WS-Federation wtrealm. On a service-provider-side relationship it is CHECKED: an assertion whose issuer is not this string is refused even when the signature verifies."
    }) `peer`?: string;
    @js(#{
      `description`:"On an identity-provider-side relationship only: the identifier of the partner's entry in `ou=applications`. Its entityID, redirect URIs and certificate stay THERE, where every protocol module reads them — this register holds a pointer and not a copy."
    }) `application`?: string;
    @js(#{
      `description`:"A CONSUMER OR SOCIAL PROVIDER (#565): the profile the relationship is made from. Its endpoints, issuer, scope and token authentication are written onto the relationship, `role` must be `service-provider` and `protocol` the profile's (both are in `consumerProviders` on `GET /admin-api/federation`), and the realm must have `federation.consumerProviders` on."
    }) `provider`?: "google" | "discord" | "github" | "microsoft" | "microsoft-any" | "linkedin" | "yahoo" | "slack" | "twitch" | "salesforce" | "facebook" | "amazon" | "spotify" | "x" | "tiktok" | "apple" | "gitlab" | "gitlab-self-managed" | "bitbucket" | "patreon" | "roblox" | "battlenet" | "epic" | "paypal" | "dropbox" | "box" | "steam" | "codeberg" | "gitea" | "huggingface" | "asana" | "atlassian" | "replit" | "mastodon" | "sourceforge" | "stackoverflow" | "oschina" | "discourse" | "bluesky" | "generic-oidc" | "generic-oauth2";
    @js(#{
      `description`:"With `provider`: this service's client_id at the provider, set as `fedClientId` in the same act."
    }) `clientId`?: string;
    @js(#{
      `description`:"With `provider`: this service's secret at the provider, set as `fedClientSecret` in the same act and sealed as that field always is. Never echoed."
    }) `clientSecret`?: string
  },
  `responses/200/content/application~1json/schema`: `SharedModel241`,
  `responses/400/content/application~1json/schema`: `SharedModel241`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/federation/set",
  "post",
  #{
    `operationId`:"setFederationField",
    `summary`:"Set one single-valued field on a relationship",
    `description`:"The field must be one of this relationship's — a field belonging to the other ROLE is refused by name rather than written and ignored, and so is one that records what HAPPENED (the counters, the last error).\n\n`fedId`, `fedRole` and `fedProtocol` are refused too, and that is a third category rather than an oversight: they are the relationship's identity, and changing one would leave a SAML relationship carrying a token endpoint. Delete it and make another — there is no state to lose but the counters.\n\n`GET /admin-api/federation?relationship=<id>` returns `editable`, which is exactly the list this operation accepts, so a caller need not guess.\n\nThe reply always carries `readiness`, so setting the last missing field tells you it was the last one.\n\n**Mirrors** `POST /admin/federation` on the admin console.",
    `tags`:#["Federation"],
    `responses`:#{
      `200`:#{
        `description`:"The relationship as it now stands, and whether it is ready.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `setFederationField`(@js(#{
    `examples`:#[
      #{
        `id`:"partner-a",
        `field`:"fedSsoUrl",
        `value`:"https://idp.partner.example/sso"
      }
    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"The relationship."}) `id`: string;
    @js(#{
      `description`:"The attribute name, e.g. `fedSsoUrl`, `fedSigningCertificate`, `fedClientId`."
    }) `field`: "fedName" | "fedPeer" | "fedLocalEntityId" | "fedEnabled" | "fedSsoUrl" | "fedTokenUrl" | "fedUserinfoUrl" | "fedJwksUri" | "fedEmailsUrl" | "fedJwks" | "fedTrustAnchor" | "fedSigningCertificate" | "fedClientId" | "fedClientSecret" | "fedResponseMode" | "fedTeamId" | "fedKeyId" | "fedClientSigningKey" | "fedTokenAuth" | "fedScope" | "fedResponseType" | "fedIdTokenSignedResponseAlg" | "fedUserinfoSignedResponseAlg" | "fedRefreshTokens" | "fedRefreshEverySeconds" | "fedRegister" | "fedRegisteredIssuer" | "fedRequestObject" | "fedRequestObjectSigningAlg" | "fedWebFinger" | "fedDiscovery" | "fedInitiateLogin" | "fedBinding" | "fedSignRequest" | "fedUsernameSource" | "fedSubjectClaim" | "fedAutocreateUsers" | "fedUpdateUserAttributes" | "fedProvisionGroups" | "fedProvisionCap" | "fedProvisionIdleMinutes" | "fedSubjectPolicy" | "fedSubjectPattern" | "fedMayAssertAdministrators" | "fedSignalEmailMatch" | "fedSignalsEnabled" | "fedSignalsIssuer" | "fedSignalsDelivery" | "fedSignalsTokenUrl" | "fedSignalsClientId" | "fedSignalsClientSecret" | "fedSignalsScope" | "fedSignalsBearer" | "fedSloUrl" | "fedSloBinding" | "fedEndSessionUrl" | "fedAcceptSignout" | "fedRequireSignedLogout" | "fedEncryptionKeyType" | "fedKeyManagementAlgorithm" | "fedContentEncryptionAlgorithm" | "fedAllowUnencrypted" | "fedAllowUnsolicited" | "fedApplication" | "fedAuthnMechanism" | "fedAuthnRelationship";
    @js(#{
      `description`:"The new value. An empty string clears it. `fedSigningCertificate` is normalised — PEM armour and whitespace are stripped, because what the schema holds is the base64 DER a ds:X509Certificate carries."
    }) `value`: string
  },
  `responses/200/content/application~1json/schema`: `SharedModel241`,
  `responses/400/content/application~1json/schema`: `SharedModel241`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/federation/add-value",
  "post",
  #{
    `operationId`:"addFederationValue",
    `summary`:"Add a value to a multi-valued field",
    `description`:"Any multi-valued field: the relationship's own `editable` table marks them, and this operation's `field` lists them. A field holding one value is refused rather than assigned (#747). Two have rules of their own.\n\n**`fedAttributeMap`** is written `<incoming name>=<LDAP attribute>` and is split at the FIRST equals sign — which matters, because an incoming name can be a URL and a URL can hold one. It is only needed for a partner's own inventions: the ordinary OpenID Connect claims, the SAML `urn:oid:` names and the AD FS claim URIs are mapped already.\n\n**`fedRelease`** names an attribute or claim released to that partner, and it can only REMOVE — from what /admin/claims, /admin/saml-attributes and the groups claim would add, and from nothing else. It cannot touch `sub`, `iss`, `exp` or a NameID. **NO VALUES MEANS NO POLICY, not release nothing**: adding the first value here is what starts the filtering.\n\n**Mirrors** `POST /admin/federation` on the admin console.",
    `tags`:#["Federation"],
    `responses`:#{
      `200`:#{
        `description`:"The relationship with the value added.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `addFederationValue`(@js(#{
    `examples`:#[
      #{
        `id`:"partner-a",
        `field`:"fedAttributeMap",
        `value`:"http://partner.example/claims/dept=departmentNumber"
      }
    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"The relationship."}) `id`: string;
    @js(#{`description`:"Which list."}) `field`: "description" | "fedAllowedTenants" | "fedAuthorizeParams" | "fedAttributeMap" | "fedSubjectGroup" | "fedSubjectDomain" | "fedHomeRealmDomain" | "fedSignalsEvents" | "fedRelease";
    @js(#{`description`:"The value to add."}) `value`: string
  },
