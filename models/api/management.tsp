    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `setUserServiceAccount`(@js(#{
    `examples`:#[
      #{
        `user`:"svc-backup",
        `serviceAccount`:true,
        `owners`:#["cn=operations,ou=groups,dc=example,dc=com","alice"]
