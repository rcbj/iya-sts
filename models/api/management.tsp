        `name`:"group",
        `in`:"query",
        `required`:false,
        `schema`:null,
        `description`:"Count the members of this group only (its cn or its DN). At most 50000 members are read; `population.complete` says whether that was all of them."
      },
      #{
        `name`:"profile",
        `in`:"query",
        `required`:false,
        `schema`:null,
        `description`:"Count the people a NAMED passkey profile selects by group (#535, #1235: the members of the groups whose `stsPasskeyPolicy` names it), bounded as `group` is. `default` is refused: it selects nobody by group."
      },
      #{
        `name`:"application",
        `in`:"query",
        `required`:false,
        `schema`:null,
        `description`:"An application's population: anybody may sign in to it, so the counts are the realm's, with `application` saying which passkey profile governs its sign-ins and how many group-selected profiles could still win for a person."
