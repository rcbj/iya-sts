@endpoint("/admin-api/xacml/set-expression-selector",
  "post",
  #{
    `operationId`:"setXacmlExpressionSelector",
    `summary`:"Replace an expression with an AttributeSelector",
    `description`:"An XPath over the `<Content>` of a request category, rather than a named attribute — and it returns a BAG exactly as a designator does, so most functions still need a `one-and-only` around it.\n\nThe namespace bindings its prefixes need TRAVEL WITH THE DOCUMENT: a prefix in the path means nothing without one, and an unresolvable prefix is an empty bag, which is NotApplicable, which looks exactly like a policy that decided you may not. Set them with edit-selector.\n\n**Mirrors** `POST /admin/xacml#xacml-tab-policies, POST /admin/xacml#xacml-tab-editor, POST /admin/xacml#xacml-tab-peps, POST /admin/xacml/policies, POST /admin/xacml/editor and POST /admin/xacml/peps` on the admin console.",
    `tags`:#["XACML"],
    `responses`:#{
      `200`:#{
        `description`:"The operation was applied.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `setXacmlExpressionSelector`(@js(#{`examples`:#[#{`policy`:"my-policy",`path`:"rules.0.condition.args.0"}]}) `requestBody/content/application~1json/schema`: {
    @js(#{
      `description`:"The directory entry name of the policy to edit — the `cn` under ou=policies, not the PolicyId inside the document."
    }) `policy`: string;
    @js(#{
      `description`:"The node's address, from GET /admin-api/xacml/editor. ONLY VALID AGAINST THE DOCUMENT IT WAS READ FROM: remove rule 0 and every path naming rule 1 now means rule 0."
    }) `path`: string;
    @js(#{
      `description`:"The request category whose content the path runs over. Defaults to resource."
    }) `category`?: string;
    @js(#{
      `description`:"Sent as `path` — but `path` is already the node address on this endpoint, so set the XPath with edit-selector immediately afterwards. The selector arrives with `//*`, which is complete and valid."
    }) `path_xpath`?: string
  },
  `responses/200/content/application~1json/schema`: `SharedModel308`,
  `responses/400/content/application~1json/schema`: `SharedModel308`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/xacml/edit-selector",
  "post",
  #{
    `operationId`:"editXacmlSelector",
    `summary`:"Change an AttributeSelector's path, category or bindings",
    `description`:"ONE NAMESPACE BINDING AT A TIME, because the console this mirrors has no JavaScript and cannot grow a row: send `namespacePrefix` with `namespaceUri` to add or change one, and `namespacePrefix` with an empty `namespaceUri` to remove it.\n\n`ContextSelectorId` names an attribute holding the node the path starts from; absent means the whole content.\n\n**Mirrors** `POST /admin/xacml#xacml-tab-policies, POST /admin/xacml#xacml-tab-editor, POST /admin/xacml#xacml-tab-peps, POST /admin/xacml/policies, POST /admin/xacml/editor and POST /admin/xacml/peps` on the admin console.",
    `tags`:#["XACML"],
    `responses`:#{
      `200`:#{
        `description`:"The operation was applied.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `editXacmlSelector`(@js(#{
    `examples`:#[
      #{
        `policy`:"my-policy",
        `path`:"rules.0.condition.args.0",
        `namespacePrefix`:"md",
        `namespaceUri`:"http://www.medico.com/schemas/record"
      }
    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{
      `description`:"The directory entry name of the policy to edit — the `cn` under ou=policies, not the PolicyId inside the document."
    }) `policy`: string;
    @js(#{
      `description`:"The node's address, from GET /admin-api/xacml/editor. ONLY VALID AGAINST THE DOCUMENT IT WAS READ FROM: remove rule 0 and every path naming rule 1 now means rule 0."
    }) `path`: string;
    @js(#{
      `description`:"Sent as `path` collides with the node address; this operation reads the XPath from `path` ONLY when it is not the address — see the console form, which posts them separately."
    }) `path_xpath`?: string;
    @js(#{`description`:"The category whose content is selected."}) `category`?: string;
    @js(#{`description`:"The datatype of the bag it returns."}) `dataType`?: string;
    @js(#{
      `description`:"An attribute naming the starting node, or empty for the whole content."
