    @js(#{
      `description`:"What is asked. pqc-passkey-migration: a person holding a passkey made with a classical algorithm is asked to register a post-quantum (ML-DSA) passkey. Whether the classical passkey is replaced in place or kept beside it is the method's to say (below). Nobody is asked where the realm offers no ML-DSA algorithm at registration (the default webauthn.algorithms does). Default `pqc-passkey-migration`."
    }) `activity`: "pqc-passkey-migration";
    `snoozeDays`: post_admin_api_policies_save_postLogin_policy_b_application_json_snoozeDays_h3050;
