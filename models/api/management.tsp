@endpoint("/admin-api/credential-claims/select",
  "post",
  #{
    `operationId`:"selectCredentialClaims",
    `summary`:"Set the whole credential claim set",
    `description`:"Replaces the selection, and then SWEEPS THE DIRECTORY: every person under ou=users gains the selected attributes they are missing, invented from their username — deterministically, so one username is one invented person across restarts. An attribute already there is never overwritten, so an operator's `ldapmodify` and the seeded people's own names survive.\n\nThe sweep is the point rather than a side effect: without it, selecting `title` would change every future credential and change nothing an LDAP client could see, and the two halves of this service would stop describing the same people. The reply's `sweep` says what it did, including when there was no directory to do it to.\n\nThe issuer METADATA is built from this same selection, so what is advertised cannot drift from what is minted.\n\n**Mirrors** `POST /admin/vc#vc-tab-claims` on the admin console.",
    `tags`:#["Credential claims"],
    `responses`:#{
      `200`:#{
        `description`:"What is selected now, what changed, and what the sweep did.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `selectCredentialClaims`(@js(#{`examples`:#[#{`attributes`:#["givenName","sn","mail"]}]}) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"LDAP attribute type names, from the catalogue."}) `attributes`: (string)[]
  },
  `responses/200/content/application~1json/schema`: `SharedModel216`,
  `responses/400/content/application~1json/schema`: `SharedModel216`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

