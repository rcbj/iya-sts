@endpoint("/admin-api/userinfo-claims",
  "get",
  #{
    `operationId`:"getUserInfoClaims",
    `summary`:"What every UserInfo response will carry, and what a client may ask it for",
    `description`:"The `userinfo` claim set — the fifth of the five, and the only one whose subject is not something this service ISSUES.\n\n**A UserInfo response is built on EVERY call.** An access token, an ID Token and both SAML assertions are signed documents: a claim added to one of those sets reaches a client at its next sign-in and never reaches what it already holds. A claim added here reaches the next `GET /oauth2/userinfo` from a client that signed in an hour ago and has done nothing since. That is the whole reason it is configured separately from the ID Token set rather than being the same list under two names.\n\nThe set has the same TWO HALVES as every other and they are configured by different operations. `claims` are TYPED: a name and a value somebody wrote, the same for everybody except where a \${placeholder} carries the sign-in. `attributes` are LDAP ATTRIBUTE TYPES chosen from `attributeCatalogue`, whose value is read off that person's entry under ou=users — so an `ldapmodify` changes the next response, with no new sign-in at all.\n\n`reservedJwtClaims` IS here, unlike GET /admin-api/saml-attributes, and the reason is worth reading before assuming it is a copy-paste: `sub` is REQUIRED in this response (OIDC Core 5.3.2, and a client MUST check it against the ID Token's), and when a client has registered a `userinfo_signed_response_alg` the whole response is a JWT carrying `iss`, `aud` and `exp`.\n\n`claimsRequest` is the half no operation here sets: OIDC Core section 5.5 lets a CLIENT name individual claims in the `claims` request parameter, and this service answers them off the same catalogue. It lists every name a request may use, the four layers of precedence, what is carried and NOT enforced (`essential`, `value`, `values`), and the non-spec way to send one straight to the endpoint.\n\n**Mirrors** `GET /admin/userinfo-claims` on the admin console.",
    `tags`:#["UserInfo claims"],
    `responses`:#{
      `200`:#{
        `description`:"The UserInfo set, the attribute catalogue, the preview and the section 5.5 vocabulary.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `parameters`:#[
      #{
        `name`:"user",
        `in`:"query",
        `required`:false,
        `schema`:null,
        `description`:"Whose attribute values to preview. The same parameter, the same cap and the same default GET /admin-api/claims takes, deliberately: the three replies preview one person unless asked otherwise. `preview.entryFound` says whether the directory holds them or the values were invented from the username."
      },
      #{
        `name`:"request",
        `in`:"query",
        `required`:false,
        `schema`:null,
        `description`:"A section 5.5 claims request, as the JSON a client would send — for example `{\"userinfo\":{\"birthdate\":null,\"address\":null}}`. The reply's `claimsRequest.preview` then says exactly what that request would return for `user`, computed by the two functions the UserInfo endpoint itself calls. A MALFORMED one is reported in `claimsRequest.preview.error` and does NOT fail this call: what it shows is the `invalid_request` a client would be given, which is the thing a caller is asking about."
      }
    ],
    `security`:#[#{`oauth2`:#["admin:read"]},#{`bearerAuth`:#[]}]
  })
op `getUserInfoClaims`(@js(#{`default`:"alice"}) `parameters/0/schema`: string,
  `parameters/1/schema`: string,
  `responses/200/content/application~1json/schema`: `UserInfoClaimSets`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/userinfo-claims/add",
  "post",
  #{
    `operationId`:"addUserInfoClaim",
    `summary`:"Add one claim to one set",
    `description`:"Every UserInfo response of that kind issued from now on carries it; nothing already issued changes.\n\nADDITIVE ONLY. What the protocol puts in is never displaced — an ID Token's `sub`, a SAML 2.0 assertion's `name`, a WS-Federation assertion's whole identity claim list. A name this service sets itself is REFUSED rather than allowed to win, because every one of those is load-bearing — a settable `exp` would produce tokens that fail to verify with nothing pointing back at the call that caused it. `GET /admin-api/claims` lists the refused names.\n\n**Mirrors** `POST /admin/userinfo-claims` on the admin console.",
    `tags`:#["UserInfo claims"],
    `responses`:#{
      `200`:#{
        `description`:"The set as it now stands, in `claims`.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `addUserInfoClaim`(@js(#{`examples`:#[#{`set`:"userinfo",`name`:"dept",`value`:"engineering"}]}) `requestBody/content/application~1json/schema`: {
    `set`: "userinfo";
    `name`: string;
    @js(#{`description`:"May carry a \${...} placeholder."}) `value`?: string;
    @js(#{
      `description`:"The Kerberos PAC set only (#493): the PAC claim type. Defaults to string; ignored by the other sets."
    }) `type`?: "string" | "int64" | "uint64" | "boolean";
    @js(#{`description`:"The SAML 2.0 set only."}) `nameFormat`?: string;
    @js(#{
      `description`:"The SAML 1.1 set only. Defaults to the WS-Federation claim namespace, which is what every relying party already reads."
    }) `namespace`?: string
  },
  `responses/200/content/application~1json/schema`: `SharedModel207`,
  `responses/400/content/application~1json/schema`: `SharedModel207`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/userinfo-claims/add-attribute-claim",
  "post",
  #{
    `operationId`:"addUserInfoAttributeClaim",
    `summary`:"Add one claim carrying a directory attribute",
    `description`:"The claim's value is `attribute` on the entry of the person the UserInfo response is about (#94) — any attribute, where the directory-attribute half of a set offers only the fixed catalogue, under the name given here. Only the directory, never an invented value: a person whose entry lacks it gets no such claim, and a lower layer of the same name still answers. `multi` carries every value. A secret, a binary value or an attribute this service keeps (sts*, hoba*, app*, pwd*) is refused. Removed by `remove`, by name. The same reserved names are refused as for `add`, and a directory write that moves the attribute sends CAEP token-claims-change to holders of live tokens.\n\n**Mirrors** `POST /admin/userinfo-claims` on the admin console.",
    `tags`:#["UserInfo claims"],
    `responses`:#{
      `200`:#{
        `description`:"The set as it now stands, in `claims`.",
