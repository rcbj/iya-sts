@js(#{`minimum`:19456,`maximum`:1048576}) @hoisted scalar post_admin_api_policies_save_password_policy_b_application_json_argon2Memory_v0_h2966 extends integer;
  

@js(#{
    `description`:"The memory one argon2id hash uses, in kibibytes (m). 19456 KiB (19 MiB) is OWASP's minimum and the least this service will write. Raising it makes a stolen store slower to attack, and every sign-in uses that much more memory. Between 19456 and 1048576. Default 19456.",
    `$comb`:"oneOf"
  }) @hoisted union post_admin_api_policies_save_password_policy_b_application_json_argon2Memory_h2967 {
    post_admin_api_policies_save_password_policy_b_application_json_argon2Memory_v0_h2966,
    string
  }

@js(#{`minimum`:2,`maximum`:16}) @hoisted scalar post_admin_api_policies_save_password_policy_b_application_json_argon2Iterations_v0_h2968 extends integer;
  

@js(#{
    `description`:"How many passes argon2id makes over its memory (t). 2 is OWASP's minimum at 19 MiB; each pass adds the same time again. Between 2 and 16. Default 2.",
    `$comb`:"oneOf"
  }) @hoisted union post_admin_api_policies_save_password_policy_b_application_json_argon2Iterations_h2969 {
    post_admin_api_policies_save_password_policy_b_application_json_argon2Iterations_v0_h2968,
    string
  }

@js(#{`minimum`:1,`maximum`:16}) @hoisted scalar post_admin_api_policies_save_password_policy_b_application_json_argon2Parallelism_v0_h2970 extends integer;
  

@js(#{
    `description`:"How many lanes argon2id divides its memory into (p). It is part of the hash, not a thread count: node computes a hash on one thread whatever this says. 1 is OWASP's figure. Between 1 and 16. Default 1.",
    `$comb`:"oneOf"
  }) @hoisted union post_admin_api_policies_save_password_policy_b_application_json_argon2Parallelism_h2971 {
