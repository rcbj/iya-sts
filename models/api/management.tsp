@endpoint("/admin-api/policies/save-password-policy",
  "post",
  #{
    `operationId`:"savePasswordPolicy",
    `summary`:"Set the password policy profile",
    `description`:"Writes `cn=<profile>,ou=passwordPolicies` in this realm's directory, REPLACING what is there: `default`, or a named policy, created by its first save (#1236). `generatedLength` must be at least `minLength`, and `minSymbols`, `requireUppercase` and `requireDigit` may only be 0 or false (ASVS 5.0.0 6.2.5). An application (`appPasswordPolicy`) and a group (`stsPasswordPolicy`) name a named policy; of those naming one for a person the lowest `precedence` applies (ties by name), else `default`, and a reference to a policy the realm does not hold names nothing, and the rest still rank (STS-AUTHN-0539). A named policy still named is not removed (STS-AUTHN-0540). **A change applies to the NEXT password set in this realm and to nothing already stored**, which is a hash and cannot be re-checked.\n\n**Every field is required** and one left out is refused by name rather than reset to a default, because a save that quietly loosened a rule nobody mentioned is the mistake nobody sees.\n\n**Mirrors** `POST /admin/policies` on the admin console.",
    `tags`:#["Policies"],
    `responses`:#{
      `200`:#{
        `description`:"The profile now in force and the rules as sentences.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `savePasswordPolicy`(@js(#{
    `examples`:#[
      #{
        `profile`:"default",
        `minLength`:14,
        `history`:5,
        `minSymbols`:0,
        `requireUppercase`:false,
        `requireDigit`:false,
        `generatedLength`:20,
        `hashAlgorithm`:"scrypt",
        `argon2Memory`:19456,
        `argon2Iterations`:2,
        `argon2Parallelism`:1,
        `scryptLogN`:15,
        `scryptBlockSize`:8,
        `scryptParallelism`:1
      }
    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{
      `pattern`:"^(default|[a-z0-9][a-z0-9-]{0,63})$",
      `description`:"Which profile: `default`, or a named profile (lower-case letters, digits and hyphens), which is created by its first save."
    }) `profile`?: string;
    @js(#{`description`:"What the profile is for, for the next person. Optional."}) `description`?: string;
    `precedence`?: post_admin_api_policies_save_password_policy_b_application_json_precedence_h2955;
    `minLength`: post_admin_api_policies_save_password_policy_b_application_json_minLength_h2957;
    `history`: post_admin_api_policies_save_password_policy_b_application_json_history_h2959;
    `minSymbols`: post_admin_api_policies_save_password_policy_b_application_json_minSymbols_h2961;
    `requireUppercase`: post_admin_api_policies_save_password_policy_b_application_json_requireUppercase_h2962;
    `requireDigit`: post_admin_api_policies_save_password_policy_b_application_json_requireDigit_h2963;
    `generatedLength`: post_admin_api_policies_save_password_policy_b_application_json_generatedLength_h2965;
    @js(#{
      `description`:"The algorithm a newly stored password is hashed with: scrypt (RFC 7914), the default, or argon2id (RFC 9106, the OWASP Password Storage Cheat Sheet's first choice). A stored hash names its own algorithm and parameters and keeps verifying; one that is not in this algorithm with these parameters is hashed again at the person's next verified sign-in. Client secrets, activation tokens, recovery codes and app passwords are not passwords and stay scrypt. Default `scrypt`."
    }) `hashAlgorithm`?: "scrypt" | "argon2id";
