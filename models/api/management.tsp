      `keyAlgorithms`?: (string)[];
      `defaultKeyAlg`?: string
    };
    `current`?: integer;
    `stale`?: integer;
    `protocolEndpoints`?: `SharedModel49`
  },
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/xacml/create-from-template",
  "post",
  #{
    `operationId`:"createXacmlPolicy",
    `summary`:"Create a policy from a template",
    `description`:"A template is a working, valid, evaluable policy in a shape people actually write — the first twenty clicks of the editor already made. `template` names one (see GET /admin-api/xacml/policies), `name` names the directory entry, and each parameter is sent as `p_<name>`; anything omitted takes the template's own default, so a call with only `template` produces the documented example.\n\n`blank` is the one template that is not an example: it builds an EMPTY Policy, or an empty PolicySet with `p_kind=policyset` — which is the only way to create one of those without ALFA. An empty deny-unless-permit document DENIES rather than answering NotApplicable, so build it before making it the root.\n\nA template BUILDS THE MODEL and the writer serializes it, rather than substituting into XML text — so a role called `a\"b` cannot produce a document that will not parse.\n\nThe FIRST policy in an empty repository becomes the root, because a repository with a policy and no root decides nothing.\n\n**Mirrors** `POST /admin/xacml#xacml-tab-policies, POST /admin/xacml#xacml-tab-editor, POST /admin/xacml#xacml-tab-peps, POST /admin/xacml/policies, POST /admin/xacml/editor and POST /admin/xacml/peps` on the admin console.",
    `tags`:#["XACML"],
    `responses`:#{
      `200`:#{
        `description`:"The operation was applied.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `createXacmlPolicy`(@js(#{
    `examples`:#[#{`template`:"rbac",`name`:"example-rbac"}],
    `additionalProperties`:true
  }) `requestBody/content/application~1json/schema`: {
    @js(#{
      `description`:"Which template. GET /admin-api/xacml/policies lists them with the parameters each takes."
    }) `template`: string;
    @js(#{
      `description`:"Names the DIRECTORY ENTRY. The PolicyId inside the document is a separate identifier and may be any URI."
    }) `name`?: string
  },
  `responses/200/content/application~1json/schema`: `SharedModel308`,
  `responses/400/content/application~1json/schema`: `SharedModel308`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/xacml/import-alfa",
  "post",
  #{
    `operationId`:"importXacmlAlfa",
    `summary`:"Create a policy from ALFA",
    `description`:"ALFA — the Abbreviated Language For Authorization — is the readable syntax for XACML: forty lines of XML are eight of ALFA. Send it as `alfa` and a name as `name`.\n\nIT IS PARSED, CONVERTED AND STORED AS XACML XML. The repository holds ONE representation, because two would be two documents that could disagree — GET /admin-api/xacml/editor renders the ALFA back from the model whenever you want to read it.\n\nEVERY ATTRIBUTE MUST BE DECLARED BEFORE IT IS USED. That is ALFA's own rule and it is the most useful refusal in the parser: a typo in an attribute name is otherwise a policy that quietly matches nothing, which looks exactly like a policy that is working and denying you.\n\nALFA IS AN OASIS COMMITTEE SPECIFICATION DRAFT, not a ratified standard — no conformance suite, no schema, no second implementation to disagree with. The contract offered is the one that can be kept: anything this service EMITS as ALFA it reads back, and the policy decides identically either way.\n\n**Mirrors** `POST /admin/xacml#xacml-tab-policies, POST /admin/xacml#xacml-tab-editor, POST /admin/xacml#xacml-tab-peps, POST /admin/xacml/policies, POST /admin/xacml/editor and POST /admin/xacml/peps` on the admin console.",
    `tags`:#["XACML"],
    `responses`:#{
      `200`:#{
        `description`:"The operation was applied.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `importXacmlAlfa`(@js(#{
    `examples`:#[
      #{
        `name`:"example-alfa",
        `alfa`:"namespace example {\n    attribute employeeType {\n        id = \"employeeType\"\n        type = \"string\"\n        category = subjectCat\n    }\n    policy exampleAlfa {\n        apply denyUnlessPermit\n        rule allowStaff {\n            permit\n            target clause employeeType == \"staff\"\n        }\n    }\n}"
      }
    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{
      `description`:"The ALFA source. Parsed, converted and stored as XACML XML — the repository holds ONE representation."
    }) `alfa`: string;
    @js(#{`description`:"Names the directory entry."}) `name`: string
  },
  `responses/200/content/application~1json/schema`: `SharedModel308`,
  `responses/400/content/application~1json/schema`: `SharedModel308`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

