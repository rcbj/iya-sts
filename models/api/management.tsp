@endpoint("/admin-api/passkey-report/recount",
  "post",
  #{
    `operationId`:"recountPasskeyReport",
    `summary`:"Count the realm's passkeys again, now",
    `description`:"Queues a run of the `passkeys.report-recount` job for this realm on the scheduler's leader (#49), which reads every passkey holder a page at a time and makes the result the new baseline — putting right whatever the changes noted since could not see (a bulk import, a restore). It runs where every job runs, never on this request: the answer is the queued run (`runId`, `alreadyQueued`), and Monitoring → Scheduler shows it. Audited by the scheduler.\n\n**Mirrors** `POST /admin/passkey-report` on the admin console.",
    `tags`:#["Monitoring"],
    `responses`:#{
      `200`:#{
        `description`:"The queued run.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:false,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
