@endpoint("/admin-api/mfa/clear-totp",
  "post",
  #{
    `operationId`:"clearAuthenticatorApp",
    `summary`:"Clear somebody's authenticator app enrolment",
    `description`:"**THE ONLY WAY BACK FOR SOMEBODY WHO HAS LOST THEIR PHONE.** The shared secret lives on that device and this service cannot reach it, and there is deliberately no self-service reset anywhere — a second factor anybody can remove is not a second factor.\n\nIt CANNOT lock anybody out: a one-time code is never a primary credential here, so clearing one drops the account to one factor rather than to none. The person sets a new one up at `/portal/mfa`.\n\nClearing an enrolment nobody holds answers 400 rather than 200, because unlike a role grant there is no idempotent reading of it that is useful: the caller asked to clear a specific thing and it was not there.\n\n**Mirrors** `POST /admin/users` on the admin console.",
    `tags`:#["Multi-factor authentication"],
    `responses`:#{
      `200`:#{
        `description`:"Whose enrolment was cleared. `sessionsEnded` counts the sessions the app's codes signed in, which were ended (#722); every other stays.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `clearAuthenticatorApp`(@js(#{`examples`:#[#{`username`:"alice"}]}) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"How the person's identity was verified, in at least 8 characters. Product mode requires it, and it is recorded in the audit log."}) `evidence`?: string;
    @js(#{`description`:"The name they sign in as."}) `username`: string;
    @js(#{`description`:"Accepted for `username`."}) `user`?: string
