@endpoint("/admin-api/policies/save-authn-policy",
  "post",
  #{
    `operationId`:"saveAuthnPolicy",
    `summary`:"Set the authentication policy profile",
    `description`:"Writes `cn=default,ou=authnPolicies` in this realm's directory, REPLACING what is there — in the DEFAULT realm, the profile every realm without its own follows. At least one mechanism must be a first factor, and with `requireSecondFactor: always` at least one a second. **An email mechanism cannot be turned on while this realm cannot send mail** (`STS-AUTHN-0244`), and NIST SP 800-63B-4 section 3.1.3.1 advises against email as an authenticator at all, which is why both are off by default. There is no `never`: a person who holds a second factor is always asked for it.\n\n**Every field is required** and one left out is refused by name rather than reset to a default, because a save that quietly loosened a rule nobody mentioned is the mistake nobody sees. The only profile is `default`: nothing assigns a profile to a person, so another name is refused rather than stored.\n\n**Mirrors** `POST /admin/policies` on the admin console.",
    `tags`:#["Policies"],
    `responses`:#{
      `200`:#{
        `description`:"The profile now in force and the rules as sentences.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `saveAuthnPolicy`(@js(#{
    `examples`:#[
      #{
        `profile`:"default",
        `requireSecondFactor`:"if-held",
        `requireSecondFactorForAdministrators`:"offer",
        `passwordPrimary`:true,
        `passwordSecondFactor`:true,
        `passkeyPrimary`:true,
        `securityKeySecondFactor`:true,
        `totpSecondFactor`:true,
        `recoveryCodeSecondFactor`:true,
        `emailCodePrimary`:false,
        `emailCodeSecondFactor`:false,
        `emailLinkPrimary`:false,
        `emailLinkSecondFactor`:false,
        `certificatePrimary`:true,
        `kerberosPrimary`:true,
        `walletPrimary`:true,
        `walletSecondFactor`:true,
        `federationPrimary`:true,
        `emailCodeTtlS`:240,
        `emailCodeAttempts`:5,
        `emailResendS`:60,
        `emailFailureLimit`:100,
        `rememberedBrowserSkipsSecondFactor`:false,
        `rememberedBrowserDays`:30
      }
    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"Which profile. Only `default` exists."}) `profile`?: "default";
    @js(#{`description`:"What the profile is for, for the next person. Optional."}) `description`?: string;
    @js(#{
      `description`:"`if-held`: a person is asked for a second factor when they hold one (or their entry says stsMfaRequired). `always`: everybody in this realm is, and somebody who holds none is sent to enrol one at their next sign-in. This replaced authn.mfaRequired. There is no \"never\": a held factor is always asked for. Default `if-held`."
    }) `requireSecondFactor`: "if-held" | "always";
    @js(#{
      `description`:"For anybody holding a console role (Admin Read or Admin Write) who holds no second factor. `offer`: they are shown the step that sets one up, with an Ignore button, at every sign-in. `always`: they must set one up before they are signed in — except the default realm's built-in administrator (admin.bootstrapUsername), who is only ever offered one, so a service is never left with nobody who can sign in. `if-held`: as everybody else, by the field above. WEAKER THAN `always`: an administrator on a password alone is an administrator anyone with the password is. Default `offer`."
    }) `requireSecondFactorForAdministrators`: "if-held" | "offer" | "always";
    `passwordPrimary`: post_admin_api_policies_save_authn_policy_b_application_json_passwordPrimary_h2978;
    `passwordSecondFactor`: post_admin_api_policies_save_authn_policy_b_application_json_passwordSecondFactor_h2979;
    `passkeyPrimary`: post_admin_api_policies_save_authn_policy_b_application_json_passkeyPrimary_h2980;
    `securityKeySecondFactor`: post_admin_api_policies_save_authn_policy_b_application_json_securityKeySecondFactor_h2981;
    `totpSecondFactor`: post_admin_api_policies_save_authn_policy_b_application_json_totpSecondFactor_h2982;
    `recoveryCodeSecondFactor`: post_admin_api_policies_save_authn_policy_b_application_json_recoveryCodeSecondFactor_h2983;
    `emailCodePrimary`: post_admin_api_policies_save_authn_policy_b_application_json_emailCodePrimary_h2984;
    `emailCodeSecondFactor`: post_admin_api_policies_save_authn_policy_b_application_json_emailCodeSecondFactor_h2985;
    `emailLinkPrimary`: post_admin_api_policies_save_authn_policy_b_application_json_emailLinkPrimary_h2986;
    `emailLinkSecondFactor`: post_admin_api_policies_save_authn_policy_b_application_json_emailLinkSecondFactor_h2987;
    `certificatePrimary`: post_admin_api_policies_save_authn_policy_b_application_json_certificatePrimary_h2988;
