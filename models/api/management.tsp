@endpoint("/admin-api/token-lifetimes",
  "get",
  #{
    `operationId`:"getTokenLifetimes",
    `summary`:"How long tokens issued here are good for",
    `description`:"The three lifetimes — access token, ID Token, refresh token — the clock skew applied wherever this service reads one of its own tokens back, and the two RFC 9700 mode refresh-token rules: the idle timeout and revocation on sign-out.\n\nAll six are ordinary configuration settings and appear in `GET /config` too; `settings` here is the same row shape, carrying each one's bounds, its source and its default. `lifetimes` beside it is just the three lifetimes and the skew, for a caller that wants the value rather than the provenance.\n\nIt also reports WHAT IS ALREADY OUT THERE, per kind, counted against the same clock the endpoints use — the skew is applied to that count, so a token this calls expired is one POST /oauth2/introspect will report inactive.\n\nA LIFETIME IS STAMPED INTO A TOKEN WHEN IT IS SIGNED, so changing one reaches the next token and nothing already issued. To take an issued token out of circulation, revoke it under Tokens.\n\n**Mirrors** `GET /admin/token-lifetimes` on the admin console.",
    `tags`:#["Token lifetimes"],
    `responses`:#{
      `200`:#{
        `description`:"The six settings, and what has been issued under them.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `security`:#[#{`oauth2`:#["admin:read"]},#{`bearerAuth`:#[]}]
  })
op `getTokenLifetimes`(`responses/200/content/application~1json/schema`: `TokenLifetimes`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/token-lifetimes/set",
  "post",
  #{
    `operationId`:"setTokenLifetimes",
    `summary`:"Set one or more of the six",
    `description`:"A RUNTIME OVERRIDE, like every other change made through this API: written down and re-applied at the next start when `persistence.appconfig` has a store under it (`persistence.realms` for a write made inside a realm), and gone on restart only with `persistence.mode=memory`; the reply's `message` says which. Nothing writes to the appconfig file in either case.\n\nName any of the six; the console form posts them all at once and a caller may post one. ALL-OR-NOTHING: every value is checked before any is written, so a body with one bad field changes nothing and names it.\n\nUNLIKE `POST /config/set-many`, a property that is not one of the six is REFUSED rather than ignored. That door is for a form posting a whole section, where an unknown field is ordinary; this one is for a caller that means to set a lifetime, where a misspelt key that succeeded and changed nothing is the worst possible answer.\n\nEvery lifetime must be a whole number of THIRTY-SECOND units, between 30 and 2592000 (thirty days). The skew is 0 to 300 in the same units. The idle timeout is whole seconds, 0 turning it off, and revocation on sign-out is a boolean. Those bounds are on each setting's row in the GET, so a client can render them rather than repeat them.\n\nThe change applies to the NEXT token signed. Nothing already issued is affected: a lifetime is a claim inside a signed statement.\n\n**Mirrors** `POST /admin/token-lifetimes` on the admin console.",
    `tags`:#["Token lifetimes"],
    `responses`:#{
      `200`:#{
        `description`:"What was applied, in `applied`, and what actually changed, in `changed`.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `setTokenLifetimes`(@js(#{
    `description`:"One property per setting, named by its dot path. THESE AND NO OTHERS, and the list below is BUILT from the one this action refuses against rather than typed beside it: the door refuses anything outside it BY NAME, which is the whole reason it exists beside `POST /config/set-many` — that one IGNORES a key it does not know, which is right for a form posting a section and wrong for a caller who misspelt a lifetime. A document short by one is then a caller refused for following it.",
    `examples`:#[
      #{
        `oauth2.accessTokenTtlS`:60,
        `oauth2.idTokenTtlS`:60,
        `oauth2.refreshTokenTtlS`:86400,
        `oauth2.clockSkewS`:30
      }
    ]
  }) `requestBody/content/application~1json/schema`: {
    @js(#{`description`:"Access token lifetime (s)"}) `oauth2.accessTokenTtlS`?: integer;
    @js(#{`description`:"ID Token lifetime (s)"}) `oauth2.idTokenTtlS`?: integer;
    @js(#{`description`:"Refresh token lifetime (s)"}) `oauth2.refreshTokenTtlS`?: integer;
    @js(#{`description`:"Refresh token idle timeout (s)"}) `oauth2.refreshIdleSeconds`?: integer;
    @js(#{`description`:"Revoke refresh tokens on sign-out"}) `oauth2.revokeRefreshOnLogout`?: boolean;
    @js(#{`description`:"Token clock skew (s)"}) `oauth2.clockSkewS`?: integer
  },
  `responses/200/content/application~1json/schema`: `SharedModel204`,
  `responses/400/content/application~1json/schema`: `SharedModel204`,
  `responses/default/content/application~1json/schema`: `SharedModel1`): void;
  

@endpoint("/admin-api/token-lifetimes/defaults",
  "post",
  #{
    `operationId`:"resetTokenLifetimes",
    `summary`:"Put the six back",
    `description`:"Clears the runtime override on THESE SIX ONLY, so each falls back to its environment variable, the appconfig file, or `env/defaults.js` — one hour, one hour and twenty-four hours for the lifetimes, twenty-four hours idle, revocation on sign-out on, and thirty seconds of skew.\n\nIt is deliberately not `POST /config/reset-all`, which would also drop an override somebody set on an unrelated page. A test that changed only the lifetimes should call this to put the service back; one that changed more should call that one.\n\nA setting that was not overridden is skipped rather than refused, because this means \"put these six back\" rather than \"undo this one change\" — the per-key refusal is on `POST /config/reset`, where it is the right answer.\n\n**Mirrors** `POST /admin/token-lifetimes` on the admin console.",
    `tags`:#["Token lifetimes"],
    `responses`:#{
      `200`:#{
        `description`:"The keys that had an override cleared, in `cleared`.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `400`:#{
        `description`:"The operation was refused; `errors` says why and nothing changed.",
        `content`:#{`application/json`:#{`schema`:null}}
      },
      `default`:#{
        `description`:"A refusal or a failure.",
        `content`:#{`application/json`:#{`schema`:null}}
      }
    },
    `requestBody`:#{`required`:false,`content`:#{`application/json`:#{`schema`:null}}},
    `security`:#[#{`oauth2`:#["admin:write"]},#{`bearerAuth`:#[]}]
  })
op `resetTokenLifetimes`(`requestBody/content/application~1json/schema`: {},
  `responses/200/content/application~1json/schema`: `SharedModel205`,
