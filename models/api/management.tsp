    @js(#{`description`:"Key transport algorithm"}) `saml2.keyTransportAlgorithm`?: "rsa-oaep-mgf1p" | "rsa-oaep" | "rsa-1_5";
    @js(#{`description`:"Encrypt the NameID in a LogoutRequest"}) `saml2.encryptLogoutNameId`?: boolean;
    @js(#{`description`:"Assertion lifetime (minutes)"}) `saml11.assertionLifetimeMin`?: integer;
    @js(#{`description`:"Sign the assertion"}) `saml11.signAssertion`?: boolean;
    @js(#{`description`:"Sign the response"}) `saml11.signResponse`?: boolean;
    @js(#{`description`:"Default NameIdentifier format"}) `saml11.nameIdFormat`?: string;
    @js(#{`description`:"Artifact lifetime (seconds)"}) `saml11.artifactTtlS`?: integer;
    @js(#{`description`:"Assertion lifetime (minutes)"}) `wsfed.assertionLifetimeMin`?: integer;
    @js(#{`description`:"Assertion clock skew (s)"}) `saml.clockSkewS`?: integer
  },
  `responses/200/content/application~1json/schema`: `SharedModel206`,
