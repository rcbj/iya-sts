@endpoint("/authn-api/pending/{id}/accounts", "get", #{`operationId`:"getAccountChoice",`tags`:#["Sign-in"],`summary`:"The accounts a sign-in may continue as",`description`:"The account picker's view: this browser's signed-in accounts and the signed-out ones it remembers — each by its key, names, state and times, never a sid — whether Use another account is open, and the protocol's own rows; and `csrf`. 503 with Retry-After where the browser's account set, or a session it lists, could not be read.\n\nThe door of the sign-in surface's `GET /authn/accounts`.",`parameters`:#[#{`name`:"id",`in`:"path",`required`:true,`description`:"The pending sign-in's id: a bearer capability, as the `authn` the screen was opened with.",`schema`:null}],`responses`:#{`200`:#{`description`:"The answer.",`content`:#{`application/json`:#{`schema`:null}}},`400`:#{`description`:"Refused: `{ ok: false, errors }` — the body, the id, or the act itself.",`content`:#{`application/json`:#{`schema`:null}}},`503`:#{`description`:"The answer.",`content`:#{`application/json`:#{`schema`:null}}},`default`:#{`description`:"A refusal or a failure.",`content`:#{`application/json`:#{`schema`:null}}}},`security`:#[],`x-mirrors`:"GET /authn/accounts"})
