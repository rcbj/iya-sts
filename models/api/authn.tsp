@endpoint("/authn-api/consent/{id}", "post", #{`operationId`:"answerConsent",`tags`:#["Sign-in"],`summary`:"Allows or denies what the consent screen asks",`description`:"`action: allow` writes one oauthConsent value per scope onto the person's entry and records an RFC 9396 Allow for this one request, with any limit lowered (`lim_t0r<n>_<member>`, as the page draws them; a raised one is refused); `action: deny` records nothing. Either way the pending consent is spent and the answer names the authorization request to go back to.\n\nThe door of the sign-in surface's `POST /oauth2/consent`.\n\nSent with `Content-Type: application/json`, an `Origin` of this service and `X-CSRF-Token` — the `csrf` the page's view answered, bound to the browser's `sts_session` cookie.",`parameters`:#[#{`name`:"id",`in`:"path",`required`:true,`description`:"The pending consent's id: a bearer capability, as the `consent` the consent screen was opened with, answered only to the browser whose session is the person asked.",`schema`:null}],`responses`:#{`200`:#{`description`:"The answer.",`content`:#{`application/json`:#{`schema`:null}}},`400`:#{`description`:"Refused: `{ ok: false, errors }` — the body, the id, or the act itself.",`content`:#{`application/json`:#{`schema`:null}}},`403`:#{`description`:"No Origin of this service, or no CSRF token bound to this browser's session.",`content`:#{`application/json`:#{`schema`:null}}},`415`:#{`description`:"Not a JSON body.",`content`:#{`application/json`:#{`schema`:null}}},`429`:#{`description`:"Too many attempts.",`content`:#{`application/json`:#{`schema`:null}}},`default`:#{`description`:"A refusal or a failure.",`content`:#{`application/json`:#{`schema`:null}}}},`security`:#[],`requestBody`:#{`required`:true,`content`:#{`application/json`:#{`schema`:null}}},`x-mirrors`:"POST /oauth2/consent"})
