  "listeners.map.sentences.rpIdNotCommon": {
    "en": "629aac67a80b3ff9",
    "text": "讀取登入工作階段的應用程式位於主機名稱 {{hosts}} 上，而 webauthn.rpId（{{rpId}}）並非它們全都位於其下的網域：在其中一個註冊的通行金鑰無法在另一個上使用。請將 webauthn.rpId 設為 authn.cookieDomain 所指名的網域。"
  },
  "listeners.map.sentences.rpIdEmpty": {
    "en": "d82c2e645f3ef21a",
    "text": "讀取登入工作階段的應用程式位於主機名稱 {{hosts}} 上，而 webauthn.rpId 為空白，因此每一個都是自己的依賴方：在其中一個註冊的通行金鑰無法在另一個上使用。請將 webauthn.rpId 設為 authn.cookieDomain 所指名的網域。"
  }
