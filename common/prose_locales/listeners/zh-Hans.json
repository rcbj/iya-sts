  "listeners.map.sentences.rpIdNotCommon": {
    "en": "629aac67a80b3ff9",
    "text": "读取单点登录会话的应用位于主机名 {{hosts}} 上，而 webauthn.rpId（{{rpId}}）不是它们全都隶属的域：在其中一个上注册的通行密钥无法在另一个上使用。请将 webauthn.rpId 设为 authn.cookieDomain 所指定的域。"
  },
  "listeners.map.sentences.rpIdEmpty": {
    "en": "d82c2e645f3ef21a",
    "text": "读取单点登录会话的应用位于主机名 {{hosts}} 上，而 webauthn.rpId 为空，因此每个应用各自是一个依赖方：在其中一个上注册的通行密钥无法在另一个上使用。请将 webauthn.rpId 设为 authn.cookieDomain 所指定的域。"
  }
