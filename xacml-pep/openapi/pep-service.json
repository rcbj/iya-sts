{
  "openapi": "3.1.0",
  "info": {
    "title": "IYA STS remote PEP",
    "version": "1",
    "description": "The remote XACML policy enforcement point's own API: its status overview, its liveness, the demonstration decision at /protected, the PDP's policy nudge and its own credential's CRLs. Served on the plain listener (PEP_PORT, 9090, only with PEP_HTTP=true), the HTTPS listener (PEP_HTTPS_PORT, 9443) and any listener of purpose api the service defines. With PEP_HTTP off and a CRL directory present, 9090 is a CRL-only listener that answers GET /crl/{name} and nothing else (404 STS-XPEP-0114). A method or path not listed here is 404 with the NotFound body (STS-XPEP-0009); nothing answers 405. Error codes are recorded in the PEP's log and never sent."
  },
  "servers": [
    {
      "url": "https://localhost:9443",
      "description": "The HTTPS listener, PEP_HTTPS_PORT."
    },
    {
      "url": "http://localhost:9090",
      "description": "The plain listener, PEP_PORT, with PEP_HTTP=true."
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getOverview",
        "summary": "What this PEP holds and how it is doing",
        "description": "The whole state of the PEP: the policy it holds and whether it is stale, its registration, the PIP, the HTTPS listener, the AuthZEN edge PDP, the reverse proxy, and every managed setting in force with its source. Reads nothing in the request.",
        "responses": {
          "200": {
            "description": "The overview. Cache-Control: no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            }
          },
          "404": {
            "description": "On the CRL-only listener (STS-XPEP-0114).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          }
        }
      }
    },
    "/healthcheck": {
      "get": {
        "operationId": "getHealthcheck",
        "summary": "Liveness",
        "description": "Always 200 while the process answers; it says nothing about whether the policy is current (GET / says that). The image's HEALTHCHECK, xacml-pep --healthcheck, asks this over the plain listener with PEP_HTTP=true and over HTTPS, unverified, otherwise. HEAD is 404.",
        "responses": {
          "200": {
            "description": "Alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "404": {
            "description": "On the CRL-only listener (STS-XPEP-0114).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          }
        }
      }
    },
    "/protected": {
      "get": {
        "operationId": "getProtected",
        "summary": "The demonstration decision",
        "description": "Builds an XACML request from the query with the service's request builder, decides it against the held policy (fetching the attributes the policy designates from the PDP's PIP first), applies the bias and the obligation rule of XACML 3.0 section 7.2, and answers 200 when allowed and 403 when not, with the same body. A repeated parameter keeps its last value. Every parameter not named here is a subject attribute, asserted under its own name and as urn:sts:xacml:attribute:<name>. No credential is read: the subject is what the query says.",
        "parameters": [
          {
            "name": "subject",
            "in": "query",
            "required": false,
            "description": "The access-subject's subject-id. Absent or empty: no subject attribute.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "resource",
            "in": "query",
            "required": false,
            "description": "The resource-id (anyURI). Absent or empty: the resource setting (PEP_RESOURCE), else urn:xacml-pep:protected.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "query",
            "required": false,
            "description": "The action-id. Absent or empty: GET.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subjectKind",
            "in": "query",
            "required": false,
            "description": "application says the subject is an application; any other value says user. Asserted as urn:sts:xacml:subject-kind and forwarded to the PIP.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "attributes",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "description": "Any other parameter: a subject attribute, under both spellings, unbounded and unchecked.",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed: Deny, NotApplicable or Indeterminate under the bias, or a Permit with an obligation this PEP cannot discharge (STS-XPEP-0004). No policy held is STS-XPEP-0005; Indeterminate STS-XPEP-0006.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            }
          },
          "404": {
            "description": "On the CRL-only listener (STS-XPEP-0114).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          }
        }
      }
    },
    "/notify": {
      "post": {
        "operationId": "postNotify",
        "summary": "The PDP's nudge: pull now",
        "description": "Answered on an HTTPS listener only. Says only that something may have changed: the body is not read and nothing in the request is trusted or checked. The PEP answers at once and then pulls; the outcome shows on GET / as holding.lastNudgeAt and lastNudgeResult (a failed pull is STS-XPEP-0010).",
        "requestBody": {
          "required": false,
          "description": "Ignored.",
          "content": {
            "*/*": {
              "schema": {}
            }
          }
        },
        "responses": {
          "204": {
            "description": "Accepted; the pull follows. The answer still carries Content-Type: application/json and Cache-Control: no-store."
          },
          "404": {
            "description": "On a plain listener (STS-XPEP-0112): the PDP nudges over https only. On the CRL-only listener, STS-XPEP-0114.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          }
        }
      }
    },
    "/crl/{name}": {
      "get": {
        "operationId": "getCrl",
        "summary": "A CRL of this PEP's own credential",
        "description": "The file {name} in PEP_CRL_DIR (default: the crl directory beside PEP_TLS_CERT), as stored, so that a client verifying this PEP's certificate can check it. Served on every API listener, the CRL-only one included.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "A file name; anything else is 404.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+\\.[cC][rR][lL]$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The CRL's bytes, as the file holds them (normally DER). No Cache-Control.",
            "content": {
              "application/pkix-crl": {
                "schema": {
                  "type": "string",
                  "contentMediaType": "application/pkix-crl"
                }
              }
            }
          },
          "404": {
            "description": "No CRL directory, a name of another form, or no such readable file (STS-XPEP-0009); error_description is absent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          }
        }
      }
    }
  },
