{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./tests/node_modules/@types"]
  },
  "include": [
    "server.js", "sts_metadata.js", "types/**/*.d.ts",
    "acme/*.js",
    "admin-core/*.js",
    "admin-ui/*.js",
    "authn/*.js",
    "cluster/*.js",
    "common/*.js",
    "debugger/*.js",
    "est/*.js",
    "federation/*.js",
    "gnap/*.js",
    "home/*.js",
    "kerberos/*.js",
    "ldap/*.js",
    "logout/*.js",
    "mgmt-api/*.js",
    "oauth-oidc/*.js",
    "oid4vc/*.js",
    "persistence/*.js",
    "pki/*.js",
    "portal/*.js",
    "saml/*.js",
    "scep/*.js",
    "scim/*.js",
    "spiffe/*.js",
    "ssf/*.js",
    "tls/*.js",
    "ws-federation/*.js",
    "ws-trust/*.js",
    "xacml/*.js"
  ],
  "exclude": [
    "node_modules", "tests/node_modules", "node-ldapjs",
    "common/vendored", "debugger/embedded"
  ]
}
