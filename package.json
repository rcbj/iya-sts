    "@digitalbazaar/ed25519-verification-key-2020": "^4.2.0",
    "@digitalbazaar/security-context": "^1.0.1",
    "@digitalbazaar/zcap": "^9.0.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@noble/curves": "1.4.0",
    "@noble/hashes": "1.4.0",
    "@noble/post-quantum": "^0.4.1",
    "@xmldom/xmldom": "^0.9.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "asn1js": "^3.0.10",
    "body-parser": "^2.2.2",
    "bowser": "^2.14.1",
    "bunyan": "latest",
    "cors": "^2.8.5",
    "croner": "^10.0.1",
