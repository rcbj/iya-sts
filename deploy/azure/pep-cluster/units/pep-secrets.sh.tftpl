#!/bin/bash
# SPDX-FileCopyrightText: 2026 Iya CyberSecurity Solutions, LLC
# SPDX-License-Identifier: BUSL-1.1
#
# THE MEMBER'S KEYS, FROM KEY VAULT TO A TMPFS (#1284) — AWS's ECS `secrets`
# injection, done the way deploy/azure's nodes read theirs: an Entra ID token
# for the VM's managed identity from the instance metadata endpoint, and the
# one secret `${secret}`, a JSON object of five PEM members provision.sh
# wrote (assertion_key, assertion_cert, https_cert, https_key, service_ca).
#
# WRITTEN TO ${run_dir}, a tmpfs, mode 0700 and each file 0600, root's: the
# PEP container runs as root and mounts it read-only. Nothing secret is in
# the VM's model (custom data), in a unit file or in Terraform state. A pair
# still empty (provision.sh's first pass) leaves its two paths ABSENT, which
# is the PEP's documented "start with paths that do not exist yet": it
# registers, polls, and starts its HTTPS listener once they appear — here at
# the next start after the second pass, which restarts the VM.
#
# RETRIED, because a VM can start before its identity's grant on the vault
# has propagated (Entra ID and Azure RBAC are eventually consistent).
set -euo pipefail
vault=${vault_url}
secret=${secret}
client_id=${client_id}
dir=${run_dir}
umask 077
mkdir -p "$${dir}/server"
chmod 0700 "$${dir}"
attempt=0
until
  token="$(curl -fsS -H Metadata:true \
    "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net&client_id=$${client_id}" |
    jq -r .access_token)" &&
  body="$(curl -fsS -H "Authorization: Bearer $${token}" \
    "$${vault}/secrets/$${secret}?api-version=7.4")"
do
  attempt=$((attempt + 1))
  if [ "$${attempt}" -ge 20 ];
  then
    echo "pep-secrets: could not read $${secret} from $${vault}." >&2
    exit 1
  fi
  sleep 15
done
value="$(printf '%s' "$${body}" | jq -r .value)"
unset body token
# put <json member> <file>: write it when set, take the file away when not.
put() {
  local v
  v="$(printf '%s' "$${value}" | jq -r --arg k "$1" '.[$k] // ""')"
  if [ -n "$${v}" ];
  then
    printf '%s\n' "$${v}" > "$2"
  else
    rm -f -- "$2"
  fi
}
put assertion_key "$${dir}/pep-assertion.key"
put https_cert "$${dir}/server/pep-server.crt"
put https_key "$${dir}/server/pep-server.key"
put service_ca "$${dir}/service-ca.pem"
unset value
# What the container is told about the anchor, when there is one: an env
# file of PATHS, never of secrets.
: > "$${dir}/runtime.env"
if [ -s "$${dir}/service-ca.pem" ];
then
  echo "PEP_TLS_CA=$${dir}/service-ca.pem" > "$${dir}/runtime.env"
fi
echo "pep-secrets: $${secret} written to $${dir}."
