#
# The member's keys, from Key Vault to /run/pep (pep-secrets.sh), on every
# start: /run is a tmpfs, so a reboot re-reads the current secret.
[Unit]
Description=remote PEP: keys from Key Vault
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /etc/pep/secrets.sh
