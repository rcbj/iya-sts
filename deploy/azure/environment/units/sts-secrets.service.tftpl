#
# mock-sts: the secrets the containers take as environment, read from the
# environment's Key Vault into env files on /run (a tmpfs) — ECS's `secrets`
# injection. deploy/azure/node-init/secrets.sh.
[Unit]
Description=mock-sts: secrets
Requires=sts-registry.service
After=sts-registry.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/var/lib/sts
ExecStartPre=/bin/mkdir -p ${run_dir}
ExecStartPre=/bin/chmod 0700 ${run_dir}
ExecStartPre=/usr/bin/docker pull ${init_image}
ExecStart=/usr/bin/docker run --rm --name sts-secrets-node \
  -v ${run_dir}:${run_dir} \
  -e STS_VAULT_URL=${vault_url} \
  -e AZURE_CLIENT_ID=${client_id} \
  -e STS_SECRET_OUT=${run_dir}/node-secrets.env \
  -e "STS_SECRET_MAP=${node_secret_map}" \
  ${init_image} sts-secrets
ExecStart=/usr/bin/docker run --rm --name sts-secrets-schema \
  -v ${run_dir}:${run_dir} \
  -e STS_VAULT_URL=${vault_url} \
  -e AZURE_CLIENT_ID=${client_id} \
  -e STS_SECRET_OUT=${run_dir}/schema-secrets.env \
  -e "STS_SECRET_MAP=${schema_secret_map}" \
  ${init_image} sts-secrets
%{ if global_schema_secret_map != "" ~}
ExecStart=/usr/bin/docker run --rm --name sts-secrets-global \
  -v ${run_dir}:${run_dir} \
  -e STS_VAULT_URL=${vault_url} \
  -e AZURE_CLIENT_ID=${client_id} \
  -e STS_SECRET_OUT=${run_dir}/global-schema-secrets.env \
  -e "STS_SECRET_MAP=${global_schema_secret_map}" \
  ${init_image} sts-secrets
%{ endif ~}
