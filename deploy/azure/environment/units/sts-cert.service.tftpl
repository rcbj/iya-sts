#
# iya-sts: the public certificate and its key, where the node reads them —
# AWS's cert-init. Read from the environment's vault; node-a issues or renews
# it through ACME first when it must. deploy/azure/node-init/cert.sh.
[Unit]
Description=iya-sts: public certificate
Requires=sts-registry.service
After=sts-registry.service sts-secrets.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/var/lib/sts
ExecStartPre=/bin/mkdir -p ${tls_dir}
ExecStartPre=/usr/bin/docker pull ${init_image}
ExecStart=/usr/bin/docker run --rm --name sts-cert \
  -v ${tls_dir}:${tls_dir} \
  -e STS_TLS_DIR=${tls_dir} \
  -e STS_VAULT_URL=${vault_url} \
  -e STS_TLS_SECRET=${tls_secret} \
  -e STS_TLS_HOSTNAME=${hostname} \
  -e STS_TLS_ALT_NAMES=${alt_names} \
  -e STS_CERT_ISSUER=${issuer} \
  -e STS_ACME_SERVER=${acme_server} \
  -e STS_ACME_EMAIL=${acme_email} \
  -e STS_ACME_RENEW_DAYS=${renew_days} \
  -e AZURE_CLIENT_ID=${client_id} \
  -e AZURE_SUBSCRIPTION_ID=${subscription_id} \
  -e AZURE_RESOURCE_GROUP=${dns_zone_group} \
  -e AZURE_ZONE_NAME=${dns_zone} \
  ${init_image} sts-cert
