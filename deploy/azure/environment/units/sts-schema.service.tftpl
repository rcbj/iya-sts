#
# iya-sts: postgres/schema.sql applied as the server's administrator before
# the node starts — AWS's schema-init container. Idempotent; node-a's scale
# set is made first, so the first application is never concurrent.
[Unit]
Description=iya-sts: schema
Requires=sts-secrets.service
After=sts-secrets.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/var/lib/sts
ExecStartPre=/usr/bin/docker pull ${schema_image}
ExecStart=/usr/bin/docker run --rm --name sts-schema \
  --add-host ${db_host}:${db_address} \
  --env-file ${run_dir}/schema-secrets.env \
  -e PGHOST=${db_host} \
  -e PGPORT=${db_port} \
  -e PGDATABASE=${db_name} \
  -e PGUSER=${db_user} \
  -e STS_DB_APP_USER=${db_app_user} \
  -e STS_SCHEMA_SSLMODE=${sslmode} \
  ${schema_image}
