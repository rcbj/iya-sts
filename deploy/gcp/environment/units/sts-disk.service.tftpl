#
# iya-sts: the risk-dataset upload disk, mounted and emptied (#214).
[Unit]
Description=iya-sts: the upload disk
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /etc/sts/disk.sh
