#
# iya-sts: Docker's credential helper for the project's Artifact Registry,
# with the VM's service account (Container-Optimized OS ships the helper).
[Unit]
Description=iya-sts: registry credentials
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/var/lib/sts
ExecStartPre=/bin/mkdir -p /var/lib/sts
ExecStart=/usr/bin/docker-credential-gcr configure-docker --registries=${registry_host}
