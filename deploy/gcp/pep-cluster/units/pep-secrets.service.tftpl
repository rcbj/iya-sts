#
# iya-sts remote PEP: the member's keys, from Secret Manager into files on
# ${pep_dir} (a tmpfs), with node-init's sts-secret-files (#1284). A secret
# with no version yet is left absent — the listener pair before
# provision.sh's second pass. The anchor's presence is then said to the PEP
# as PEP_TLS_CA, in an env file of its own beside the keys.
[Unit]
Description=iya-sts remote PEP: keys
Requires=pep-registry.service
After=pep-registry.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/var/lib/pep
ExecStartPre=/bin/mkdir -p ${pep_dir}
ExecStartPre=/bin/chmod 0700 ${pep_dir}
ExecStartPre=/usr/bin/docker pull ${init_image}
ExecStart=/usr/bin/docker run --rm --name pep-secrets \
  -v ${pep_dir}:${pep_dir} \
  -e STS_SECRET_DIR=${pep_dir} \
  -e "STS_SECRET_FILES=${secret_files}" \
  ${init_image} sts-secret-files
ExecStartPost=/bin/sh -c 'if [ -s ${pep_dir}/service-ca.pem ]; then echo PEP_TLS_CA=${pep_dir}/service-ca.pem; fi > ${pep_dir}/anchor.env'
