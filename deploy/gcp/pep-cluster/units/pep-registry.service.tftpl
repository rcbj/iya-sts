#
# iya-sts remote PEP: Docker's credential helper for the project's Artifact
# Registry, with the VM's service account (deploy/gcp/environment's unit).
[Unit]
Description=iya-sts remote PEP: registry credentials
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/var/lib/pep
ExecStartPre=/bin/mkdir -p /var/lib/pep
ExecStart=/usr/bin/docker-credential-gcr configure-docker --registries=${registry_host}
